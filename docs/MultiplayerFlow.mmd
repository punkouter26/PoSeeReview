sequenceDiagram
  actor UserA as "User A"
  actor UserB as "User B"
  participant ClientA as "Client A"
  participant ClientB as "Client B"
  participant Api as "PoSeeReview API"
  participant Store as "Table + Blob Storage"
  participant Reconcile as "Conflict Resolver"

  UserA->>ClientA: "Create comic from nearby restaurant"
  UserB->>ClientB: "Create comic from same restaurant"
  ClientA->>Api: "POST /api/comics"
  ClientB->>Api: "POST /api/comics"

  Api->>Store: "Read latest restaurant version"
  Store-->>Api: "Return ETag + state"
  Api->>Api: "Generate narrative + score"
  Api->>Store: "Conditional write with ETag"

  alt "No conflict"
    Store-->>Api: "Write succeeded"
    Api-->>ClientA: "201 ComicCreated"
    Api-->>ClientB: "202 Accepted / queued"
  else "Conflict detected"
    Store-->>Api: "412 Precondition Failed"
    Api->>Reconcile: "Merge request state + retry policy"
    Reconcile-->>Api: "Winning version + retry token"
    Api->>Store: "Retry write with new ETag"
    Store-->>Api: "Write succeeded"
    Api-->>ClientA: "200 ComicMerged"
    Api-->>ClientB: "200 ComicMerged"
  end

  par "State synchronization"
    Api-->>ClientA: "Signal latest comic projection"
    Api-->>ClientB: "Signal latest comic projection"
  and "Leaderboard convergence"
    Api->>Store: "Update leaderboard projection row"
    Store-->>Api: "Projection committed"
  end

  ClientA-->>UserA: "Render synchronized comic state"
  ClientB-->>UserB: "Render synchronized comic state"
