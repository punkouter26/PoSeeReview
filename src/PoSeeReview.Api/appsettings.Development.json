    "ChatProvider": "AzureOpenAI"
  },
  "Embedding": {
    "Enabled": false,
    "BaseUrl": "http://localhost:11434/v1",
    "Model": "nomic-embed-text",
    "TimeoutSeconds": 5
  }
}
