{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.StaticFiles": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  CorrelationId={CorrelationId} UserId={UserId} Env={Environment}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/posee-review-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] CorrelationId={CorrelationId} UserId={UserId} Env={Environment} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Po.SeeReview.API"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Endpoint": "https://kv-poshared.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AzureStorage": {
    "ComicsTableName": "PoSeeReviewComics",
    "ComicsContainerName": "comics",
    "RestaurantsTableName": "PoSeeReviewRestaurants",
    "LeaderboardTableName": "PoSeeReviewLeaderboard"
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedErrors": false
  },
  "Comics": {
    "MinimumReviewsRequired": 5,
    "MaximumReviewsForAnalysis": 5,
    "CacheDurationDays": 7,
    "MinimumStrangenessScore": 20
  },
  "RateLimiting": {
    "GlobalPermitLimit": 60,
    "ComicsPostPermitLimit": 3
  },
  "Takedowns": {
    "ApiKey": ""
  }
}
