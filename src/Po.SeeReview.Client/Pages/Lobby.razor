@page "/lobby"
@using Microsoft.AspNetCore.SignalR.Client
@using Po.SeeReview.Api.Lobby
@inject NavigationManager Navigation
@inject DevSessionClient DevSessionClient
@implements IAsyncDisposable

<PageTitle>Lobby - PoSeeReview</PageTitle>

<div class="lobby-container">
    <header class="lobby-header">
        <h1>🎮 Multiplayer Lobby</h1>
        <p>Waiting for players to get ready...</p>
    </header>

    @if (_errorMessage != null)
    {
        <div class="lobby-error">@_errorMessage</div>
    }

    <div class="lobby-status">
        @if (_hubState == HubConnectionState.Connected)
        {
            <span class="lobby-status-badge lobby-status-badge--connected">Connected</span>
        }
        else if (_hubState == HubConnectionState.Connecting)
        {
            <span class="lobby-status-badge lobby-status-badge--connecting">Connecting...</span>
        }
        else
        {
            <span class="lobby-status-badge lobby-status-badge--disconnected">Disconnected</span>
        }
    </div>

    <div class="lobby-players">
        <h2>Players (@_players.Count)</h2>
        @if (_players.Count == 0)
        {
            <p class="lobby-empty">No players yet. Share this page to invite others!</p>
        }
        else
        {
            <ul class="lobby-player-list">
                @foreach (var player in _players)
                {
                    <li class="lobby-player @(player.IsHost ? "lobby-player--host" : "") @(player.IsReady ? "lobby-player--ready" : "")">
                        <span class="lobby-player-icon">
                            @(player.IsHost ? "👑" : "🎮")
                        </span>
                        <span class="lobby-player-name">@player.DisplayName</span>
                        @if (player.IsHost)
                        {
                            <span class="lobby-player-role">Host</span>
                        }
                        @if (player.IsReady)
                        {
                            <span class="lobby-player-ready">Ready ✓</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <div class="lobby-actions">
        @if (_isHost)
        {
            <button class="lobby-btn lobby-btn--start" @onclick="StartGameAsync" disabled="@(!CanStart)">
                🚀 Start Game
            </button>
            @if (!CanStart)
            {
                <p class="lobby-hint">All players must be ready before starting.</p>
            }
        }
        else
        {
            <button class="lobby-btn lobby-btn--ready" @onclick="ToggleReadyAsync">
                @(_isReady ? "✓ Ready" : "Ready Up")
            </button>
        }
        <button class="lobby-btn lobby-btn--leave" @onclick="LeaveLobbyAsync">
            Leave Lobby
        </button>
    </div>
</div>

@code {
    private HubConnection? _hubConnection;
    private HubConnectionState _hubState = HubConnectionState.Disconnected;
    private List<LobbyPlayer> _players = new();
    private string? _hostConnectionId;
    private string? _errorMessage;
    private bool _isHost;
    private bool _isReady;

    private bool CanStart => _players.Count > 0 && _players.All(p => p.IsHost || p.IsReady);

    protected override async Task OnInitializedAsync()
    {
        var session = await DevSessionClient.GetCurrentSessionAsync();
        var displayName = session?.IsAnonymous == true
            ? $"GUEST{new Random().Next(10000000, 99999999)}"
            : session?.Email ?? session?.UserId ?? "Player";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/lobby"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<List<LobbyPlayer>, string?>("LobbyUpdated", (players, hostId) =>
        {
            _players = players;
            _hostConnectionId = hostId;
            _isHost = hostId == _hubConnection?.ConnectionId;
            var currentPlayer = players.FirstOrDefault(p => p.ConnectionId == _hubConnection?.ConnectionId);
            _isReady = currentPlayer?.IsReady ?? false;
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<string, bool>("PlayerReady", (connectionId, isReady) =>
        {
            var player = _players.FirstOrDefault(p => p.ConnectionId == connectionId);
            if (player != null) player.IsReady = isReady;
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<List<LobbyPlayer>>("GameStarting", (players) =>
        {
            // Navigate to game page when host starts
            Navigation.NavigateTo("/game");
        });

        _hubConnection.On<string>("Error", (message) =>
        {
            _errorMessage = message;
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.Reconnecting += _ =>
        {
            _hubState = HubConnectionState.Connecting;
            return Task.CompletedTask;
        };

        _hubConnection.Reconnected += _ =>
        {
            _hubState = HubConnectionState.Connected;
            return Task.CompletedTask;
        };

        _hubConnection.Closed += _ =>
        {
            _hubState = HubConnectionState.Disconnected;
            return Task.CompletedTask;
        };

        _hubState = HubConnectionState.Connecting;
        await _hubConnection.StartAsync();
        _hubState = HubConnectionState.Connected;

        // Join the lobby
        await _hubConnection.SendAsync("JoinLobby", displayName);
    }

    private async Task ToggleReadyAsync()
    {
        if (_hubConnection is not null)
        {
            _isReady = !_isReady;
            await _hubConnection.SendAsync("SetReady", _isReady);
        }
    }

    private async Task StartGameAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.SendAsync("StartGame");
        }
    }

    private async Task LeaveLobbyAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.StopAsync();
        }
        Navigation.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
