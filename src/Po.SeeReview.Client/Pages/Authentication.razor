@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Po.SeeReview.Client.Services
@implements IDisposable
@inject DevSessionClient DevSessionClient
@inject NavigationManager Navigation
@inject ILogger<Authentication> Logger

<div class="auth-status-container">
    <RemoteAuthenticatorView Action="@Action" OnLogInSucceeded="HandleLoginSucceededAsync">

        <LoggingIn>
            <div class="auth-status">
                <div class="auth-spinner"></div>
                <p>Opening sign-in window&hellip;</p>
                @if (_showFallback)
                {
                    <div class="auth-fallback">
                        <p>The popup seems to be taking longer than expected or was blocked.</p>
                        <button class="login-btn login-btn-tertiary" @onclick="TryRedirectSignInAsync">
                            Try redirect sign-in instead
                        </button>
                        <a href="/login" class="auth-cancel-link">Cancel and go back</a>
                    </div>
                }
            </div>
        </LoggingIn>

        <CompletingLoggingIn>
            <div class="auth-status">
                <div class="auth-spinner"></div>
                <p>Completing sign-in&hellip;</p>
            </div>
        </CompletingLoggingIn>

        <LogInFailed>
            <div class="auth-status auth-status--error">
                <p>Sign-in failed.</p>
                <a href="/login" class="login-btn login-btn-secondary">Back to login</a>
            </div>
        </LogInFailed>

    </RemoteAuthenticatorView>
</div>

@code {
    [Parameter]
    public string? Action { get; set; }

    private bool _showFallback;
    private CancellationTokenSource? _fallbackCts;

    protected override void OnParametersSet()
    {
        if (string.Equals(Action, "login", StringComparison.OrdinalIgnoreCase))
        {
            // Show redirect fallback after 8 s in case the popup is blocked.
            _fallbackCts?.Cancel();
            _fallbackCts = new CancellationTokenSource();
            _ = ShowFallbackAfterDelayAsync(_fallbackCts.Token);
        }
        else if (string.Equals(Action, "login-failed", StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogError("Microsoft login failed. The authentication flow routed to login-failed.");
        }
    }

    private async Task ShowFallbackAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(8_000, ct);
            _showFallback = true;
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* login completed before timer fired */ }
    }

    private async Task TryRedirectSignInAsync()
    {
        Logger.LogInformation("Redirect fallback triggered from auth route.");
        _fallbackCts?.Cancel();
        await DevSessionClient.PrepareForMicrosoftLoginAsync();
        LoginModeInterop.SetMsalLoginMode("redirect");
        Navigation.NavigateTo("authentication/login?returnUrl=/", forceLoad: true);
    }

    private async Task HandleLoginSucceededAsync(RemoteAuthenticationState state)
    {
        _fallbackCts?.Cancel();
        var session = await DevSessionClient.SyncFromMicrosoftIdentityAsync();
        Logger.LogInformation("Microsoft login succeeded. Session synchronized for user {UserId}", session?.UserId ?? "unknown");
        Navigation.NavigateTo("/");
    }

    public void Dispose() => _fallbackCts?.Cancel();
}
