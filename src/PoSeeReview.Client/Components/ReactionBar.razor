@* Four reactions, no comments.

   Comics expire in 24 hours, so nothing about a comic accumulates and there is no signal that
   anyone else ever saw it. A reaction is the cheapest thing a viewer can give it. A comment box
   is deliberately absent: free text about a real, named business is a moderation surface this
   app has no queue for. *@
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Shared.Enums
@inject ApiClient ApiClient
@inject FxService Fx

@* One delegating handler for the whole group, the same way the comic action bar does it:
   clicks bubble, MouseEventArgs already carries ClientX, and a reaction that clicks from the
   side of the screen it was tapped on is the cheapest spatial cue available. *@
<div class="reaction-bar" role="group" aria-label="React to this comic" @onclick="OnBarClickAsync">
    @foreach (var (kind, glyph, label) in Reactions)
    {
        var isMine = _counts?.MyReaction == kind;
        var count = CountFor(kind);

        <button type="button"
                class="reaction @(isMine ? "reaction--mine" : "")"
                @onclick="(e) => ToggleAsync(kind, glyph, e)"
                disabled="@_isSaving"
                aria-pressed="@(isMine ? "true" : "false")"
                aria-label="@($"{label}{(count > 0 ? $", {count}" : "")}")"
                title="@label">
            <span class="reaction-glyph" aria-hidden="true">@glyph</span>
            @if (count > 0)
            {
                <span class="reaction-count">@count</span>
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string PlaceId { get; set; } = string.Empty;

    /// <summary>
    /// Raised when a reaction is ADDED (never when one is withdrawn), with the glyph and the
    /// viewport x of the tap.
    /// <para>
    /// The bar does not throw the body itself: the pile lives on a canvas over the comic strip,
    /// which is a sibling component. Handing the page an event keeps the two uncoupled, and the
    /// page already owns both.
    /// </para>
    /// <para>
    /// Withdrawal is deliberately silent. Taking a reaction back is a correction, and answering
    /// it with the same flourish as giving one would make undoing a mis-tap feel like an
    /// achievement.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<ReactionThrown> OnReacted { get; set; }

    /// <param name="Glyph">The emoji to throw.</param>
    /// <param name="ClientX">Viewport x of the tap, so the sound pans to where it happened.</param>
    public readonly record struct ReactionThrown(string Glyph, double ClientX);


    /// <summary>
    /// Panned click for any reaction. Also an unlock point: an AudioContext only leaves
    /// 'suspended' from a trusted event, and on a comic opened from a shared link this bar is
    /// often the first thing the visitor touches.
    /// </summary>
    private async Task OnBarClickAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        await Fx.UnlockAudioAsync();
        await Fx.PlayTapAtAsync(e.ClientX);
    }

    /// <summary>
    /// Presentation for each reaction, kept in one array so a glyph and its label cannot drift
    /// apart the way two index-coupled arrays eventually do.
    /// </summary>
    private static readonly (ReactionKind Kind, string Glyph, string Label)[] Reactions =
    [
        (ReactionKind.Laugh, "😂", "Funny"),
        (ReactionKind.Mind, "🤯", "Genuinely bizarre"),
        (ReactionKind.Grim, "🤢", "Put me off my lunch"),
        (ReactionKind.Love, "❤️", "Love this place anyway")
    ];

    private ReactionCountsDto? _counts;
    private bool _isSaving;
    private string? _loadedPlaceId;

    /// <summary>
    /// Loads on parameter change rather than initialization: a redraw swaps the comic on the
    /// same component instance, and OnInitialized would leave the previous comic's tallies.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(PlaceId) || _loadedPlaceId == PlaceId)
        {
            return;
        }

        _loadedPlaceId = PlaceId;
        _counts = await ApiClient.GetReactionsAsync(PlaceId);
    }

    private int CountFor(ReactionKind kind) => kind switch
    {
        ReactionKind.Laugh => _counts?.Laugh ?? 0,
        ReactionKind.Mind => _counts?.Mind ?? 0,
        ReactionKind.Grim => _counts?.Grim ?? 0,
        ReactionKind.Love => _counts?.Love ?? 0,
        _ => 0
    };

    private async Task ToggleAsync(ReactionKind kind, string glyph, MouseEventArgs args)
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;

        try
        {
            // The server treats "the reaction I already hold" as a withdrawal, so the same
            // value is sent either way and the toggle rule lives in exactly one place.
            var updated = await ApiClient.SetReactionAsync(PlaceId, kind);

            // A null response means the write failed. Leaving the previous tallies on screen is
            // honest; painting an optimistic count that the server never recorded is not.
            if (updated is not null)
            {
                _counts = updated;

                // Thrown only when the reaction was ADDED, and only after the server confirmed
                // it. Withdrawal is silent — taking a mis-tap back is a correction, and giving it
                // the same flourish as leaving a reaction would be celebrating an undo. Firing
                // before the round-trip would throw a body for a write that then failed.
                if (updated.MyReaction == kind)
                {
                    await OnReacted.InvokeAsync(new ReactionThrown(glyph, args.ClientX));
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
