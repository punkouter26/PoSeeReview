@* The user-facing report flow.

   The app publishes AI-generated content about real, named businesses and had no way for a
   person to flag any of it: /api/takedowns is gated behind a shared admin key and deletes the
   comic outright. This posts to /api/reports, which records a signal and deletes nothing.

   Contact email is optional on purpose. Requiring an address on "this comic is offensive"
   suppresses exactly the reports worth having.

   A native <dialog> opened with showModal() rather than a positioned div behind a scrim. That
   was the div's problem: it LOOKED modal but the page behind it stayed live, so Tab walked out
   of the panel into the nav, Escape did nothing, and closing left focus on <body>. showModal()
   supplies all four behaviours from the platform — see wwwroot/js/modal.js for the one thing
   Blazor cannot do itself. *@
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Shared.Enums
@implements IAsyncDisposable
@inject ApiClient ApiClient
@inject IJSRuntime JS

@* role="dialog" and aria-modal are implicit on a modal <dialog>, so stating them again would
   only be noise. aria-labelledby still matters: the heading is the accessible name. *@
<dialog @ref="_dialog" class="report-dialog" aria-labelledby="report-title" @onclick="CloseAsync">
    @* Click-through is stopped so a stray tap inside the panel does not dismiss a half-filled
       form. A click landing on the backdrop targets the <dialog> itself, which is what closes. *@
    <div class="report-panel glass" @onclick:stopPropagation="true">
        @if (_submitted)
        {
            <h2 id="report-title" class="report-title">Thanks for flagging it</h2>
            <p class="report-body">@_confirmation</p>
            <div class="report-actions">
                <button type="button" class="btn btn-primary" @onclick="CloseAsync">Done</button>
            </div>
        }
        else
        {
            <h2 id="report-title" class="report-title">Report this comic</h2>
            <p class="report-body">
                Comics are generated by AI from public reviews of <strong>@RestaurantName</strong>.
                Tell us what's wrong and we'll review it.
            </p>

            <fieldset class="report-reasons">
                <legend class="visually-hidden">Reason for reporting</legend>
                @foreach (var (reason, label) in Reasons)
                {
                    <label class="report-reason">
                        <input type="radio"
                               name="report-reason"
                               checked="@(_reason == reason)"
                               @onchange="() => _reason = reason" />
                        <span>@label</span>
                    </label>
                }
            </fieldset>

            <label class="report-field">
                <span class="report-label">Anything else? (optional)</span>
                <textarea class="report-textarea"
                          rows="3"
                          maxlength="@MaxDetails"
                          @bind="_details"
                          @bind:event="oninput"
                          placeholder="What should we look at?"></textarea>
            </label>

            <label class="report-field">
                <span class="report-label">Your email (optional — only if you want a reply)</span>
                <input class="report-input" type="email" @bind="_contactEmail" placeholder="you@example.com" />
            </label>

            @if (_error is not null)
            {
                <p class="report-error" role="alert">@_error</p>
            }

            <div class="report-actions">
                <button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Sending..." : "Send report")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync" disabled="@_isSubmitting">Cancel</button>
            </div>
        }
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public string PlaceId { get; set; } = string.Empty;

    [Parameter]
    public string RestaurantName { get; set; } = "this restaurant";

    /// <summary>Raised when the dialog should close, whether or not anything was submitted.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Matches the server-side validator's cap, so the textarea cannot compose a 400.</summary>
    private const int MaxDetails = 1000;

    private static readonly (ComicReportReason Reason, string Label)[] Reasons =
    [
        (ComicReportReason.Inaccurate, "It says things that aren't in the reviews"),
        (ComicReportReason.Offensive, "The image or text is offensive"),
        (ComicReportReason.TargetsAPerson, "It identifies or targets a real person"),
        (ComicReportReason.OwnerRequest, "I represent this business and want it removed"),
        (ComicReportReason.Other, "Something else")
    ];

    private ComicReportReason _reason = ComicReportReason.Inaccurate;
    private string _details = string.Empty;
    private string _contactEmail = string.Empty;
    private bool _isSubmitting;
    private bool _submitted;
    private string? _error;
    private string _confirmation = string.Empty;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _modalActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal.js");
            _modalActive = await _module.InvokeAsync<bool>("open", _dialog, DotNetObjectReference.Create(this));
        }
        catch (JSException)
        {
            // A graphics-adjacent failure must never surface as the framework error strip over a
            // working page. The panel is still rendered and still usable without the modal
            // semantics, which is strictly better than not showing the form at all.
        }
    }

    /// <summary>
    /// Raised by js/modal.js when the native dialog closes by any route, so Escape and a backdrop
    /// click both notify the parent exactly the same way the buttons do.
    /// </summary>
    [JSInvokable]
    public Task OnNativeCloseAsync() => OnClose.InvokeAsync();

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var response = await ApiClient.SubmitReportAsync(new ComicReportRequestDto
            {
                PlaceId = PlaceId,
                Reason = _reason,
                Details = _details,
                ContactEmail = _contactEmail
            });

            _confirmation = response.Message;
            _submitted = true;
        }
        catch (HttpRequestException ex)
        {
            // Surfaced rather than swallowed. Someone reporting content needs to know whether
            // it was actually received — a silent failure here is worse than no button.
            _error = string.IsNullOrWhiteSpace(ex.Message)
                ? "We couldn't send that report. Please try again."
                : ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Closes through the native dialog so the single `close` listener in modal.js stays the only
    /// path that reports the close upward — otherwise a button press would raise OnClose twice.
    /// </summary>
    private async Task CloseAsync()
    {
        // `_modalActive` is false when the browser has no showModal() support or the import
        // failed, and then the native close below would be a no-op that silently swallowed the
        // click. Falling through to the callback keeps the dialog dismissable in every case.
        if (_modalActive && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("close", _dialog);
                return;
            }
            catch (JSException)
            {
                // Fall through to the plain callback rather than trapping the user in an open
                // dialog that no longer responds.
            }
        }

        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to release.
            }
        }
    }
}
