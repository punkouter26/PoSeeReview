@using PoSeeReview.Shared.Dtos

@* Why a place scored what it did, and which reviews the strip came from.

   The score is computed in code from three 0-10 ratings (ChatPrompts.ComputeScore), so this is
   the actual derivation, not a decoration. Sources are positions and stars, never quotes: the
   link goes to the listing, so the page cannot misquote anyone or single out a reviewer. *@
@if (Comic.Breakdown is { } b)
{
    <section class="score-why" aria-labelledby="score-why-title" data-testid="score-breakdown">
        <h2 id="score-why-title" class="score-why-title">Why @Comic.StrangenessScore?</h2>
        <dl class="score-why-list">
            @foreach (var (label, value, hint) in Rows(b))
            {
                <div class="score-why-row" title="@hint">
                    <dt>@label</dt>
                    <dd>
                        <meter min="0" max="10" low="3" high="7" optimum="10" value="@value"
                               aria-label="@($"{label}: {value} out of 10")"></meter>
                        <span class="score-why-value" aria-hidden="true">@value</span>
                    </dd>
                </div>
            }
        </dl>
        <p class="score-why-note">Absurdity sets the score; detail and gag potential amplify it.</p>
        @if (Comic.Sources.Length > 0)
        {
            <p class="score-why-sources">
                Drawn from @SourceText —
                <a href="@MapsUrl" target="_blank" rel="noopener noreferrer">read the reviews on Google Maps ↗</a>
            </p>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ComicDto Comic { get; set; } = null!;

    private static IEnumerable<(string Label, int Value, string Hint)> Rows(ScoreBreakdownDto b) =>
    [
        ("Absurdity", b.Absurdity, "How far the reported events are from a normal visit"),
        ("Detail", b.Specificity, "How concrete the odd details are"),
        ("Gag potential", b.StoryPotential, "How well it plays as a silent visual joke")
    ];

    private string SourceText
    {
        get
        {
            var parts = Comic.Sources
                .GroupBy(s => s.ReviewNumber)
                .OrderBy(g => g.Key)
                .Select(g => $"review {g.Key} ({g.First().Rating}★)")
                .ToList();

            return parts.Count switch
            {
                1 => parts[0],
                _ => $"{string.Join(", ", parts[..^1])} and {parts[^1]}"
            };
        }
    }

    private string MapsUrl => $"https://www.google.com/maps/place/?q=place_id:{Uri.EscapeDataString(Comic.PlaceId)}";
}
