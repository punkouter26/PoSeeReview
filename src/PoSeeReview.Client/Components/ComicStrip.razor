@* Comic strip component for displaying the generated comic image. *@
@implements IAsyncDisposable
@using PoSeeReview.Client.Services
@inject FxService Fx

@*
    The <img> is the real element, so it stays accessible and saveable (long-press on mobile,
    right-click save-image on desktop).

    The tilt wrapper exists because the container's own entrance animation fills `transform`
    for good; the scroll-driven tilt needs an element whose transform nobody else owns.
*@
<div class="comic-strip-tilt">
    <div @ref="_container" class="comic-strip-container">
        <img src="@ImageUrl"
             alt="@AltText(RestaurantName, Captions)"
             class="comic-strip-image"
             @onload="OnImageLoadedAsync" />
    </div>
</div>

@code {
    [Parameter]
    public string ImageUrl { get; set; } = string.Empty;

    [Parameter]
    public string RestaurantName { get; set; } = string.Empty;

    /// <summary>The caption drawn onto each panel, which only exists as pixels otherwise.</summary>
    [Parameter]
    public IReadOnlyList<string> Captions { get; set; } = [];

    /// <summary>
    /// Alt text that reads the strip panel by panel. The narrative is already visible text under
    /// the image, so it is not repeated here — the captions are the part a screen reader could
    /// not otherwise reach. Older comics have none and keep the plain title.
    /// </summary>
    public static string AltText(string restaurantName, IReadOnlyList<string> captions)
    {
        var panels = captions
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select((c, i) => $"Panel {i + 1}: {c.Trim()}")
            .ToList();

        return panels.Count == 0
            ? $"Comic strip for {restaurantName}"
            : $"Comic strip for {restaurantName}. {string.Join(" ", panels)}";
    }

    /// <summary>
    /// How many stacked panels to develop in sequence. Two is the server's cap
    /// (<c>ComicTextOverlayService.GetPanelBounds</c> stacks two panels vertically).
    /// </summary>
    private const int PanelCount = 2;

    /// <summary>
    /// Place id, used to seed the per-panel notes so scrolling the strip replays this comic's own
    /// motif. Empty disables the scrub rather than seeding it with something wrong — a motif from
    /// a blank seed is the same tune for every restaurant, which is worse than silence.
    /// </summary>
    [Parameter]
    public string PlaceId { get; set; } = string.Empty;

    /// <summary>Strangeness, which picks the scale the panel notes are drawn from.</summary>
    [Parameter]
    public int StrangenessScore { get; set; }

    /// <summary>
    /// Develop the strip top-down as it arrives, rather than showing it whole. For a comic the
    /// user just waited ten seconds for — not for one opened from a list, which morphs in instead.
    /// </summary>
    [Parameter]
    public bool Develop { get; set; }

    private ElementReference _container;
    private int _scrubHandle;
    private int _revealHandle;
    private bool _developed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(PlaceId))
        {
            _scrubHandle = await Fx.StartPanelScrubAsync(
                _container, PanelCount, PlaceId, StrangenessScore);
        }
    }

    /// <summary>
    /// The reveal waits for the pixels: developing a strip whose image has not decoded yet would
    /// spend the whole effect on an empty frame.
    /// </summary>
    private async Task OnImageLoadedAsync()
    {
        if (Develop && !_developed)
        {
            _developed = true;
            _revealHandle = await Fx.StartComicRevealAsync(_container, PanelCount);
        }
    }

    public async ValueTask DisposeAsync()
    {
        // The reveal first and unconditionally: an abandoned one leaves part of the comic masked.
        await Fx.FinishComicRevealAsync(_revealHandle);
        await Fx.StopPanelScrubAsync(_scrubHandle);
        _revealHandle = _scrubHandle = 0;
    }
}
