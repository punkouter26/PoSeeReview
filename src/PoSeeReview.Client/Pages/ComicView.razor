@page "/comic/{PlaceId}"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Shared.Enums
@using PoSeeReview.Client.Services
@using System.Threading
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject ShareService ShareService
@inject FxService Fx
@inject ILogger<ComicView> Logger

<PageTitle>@(_comic?.RestaurantName ?? "Comic") - PoSeeReview</PageTitle>

<div class="comic-view">
    @if (_isLoading)
    {
        <LoadingIndicator Message="Reading the weird stuff..."
                          Steps="@(_isRegenerating ? _regenerateSteps : _comicSteps)"
                          ActiveStep="@_activeStepIndex" />
    }
    else if (_error != null)
    {
        <RadzenCard class="error-container glass">
            <div class="error-icon">🤷</div>
            <h2>@_errorTitle</h2>
            <p class="error-message">@_error</p>
            <div class="error-actions">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn btn-primary" Click="@(_ => GoBack())">
                    &#8592; @BackLabel
                </RadzenButton>
            </div>
        </RadzenCard>
    }
    else if (_needsGeneration)
    {
        <RadzenCard class="error-container glass">
            <div class="error-icon">🎨</div>
            <h2>No Comic Here Yet</h2>
            <p class="error-message">This place doesn't have an active comic — it may have expired. Generating a fresh one takes about 10 seconds.</p>
            <div class="error-actions">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn btn-primary" Click="@(_ => GenerateFromPromptAsync())">
                    Generate Comic
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Base" class="btn btn-secondary" Click="@(_ => GoBack())">
                    &#8592; @BackLabel
                </RadzenButton>
            </div>
        </RadzenCard>
    }
    else if (_comic != null)
    {
        <RadzenCard class="comic-container glass">
            <div class="comic-header">
                <h1>@_comic.RestaurantName</h1>
                <div class="strangeness-ring-wrap">
                    <svg class="strangeness-ring" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#7C3AED"/>
                                <stop offset="100%" stop-color="#f5576c"/>
                            </linearGradient>
                        </defs>
                        <circle class="ring-bg" cx="50" cy="50" r="42" />
                        @* InvariantCulture: WASM picks up the browser locale, and a
                           comma-decimal locale would emit "13,2" and break the SVG attribute. *@
                        <circle class="ring-fill" cx="50" cy="50" r="42"
                                style="stroke-dasharray: @RingDashArray" />
                    </svg>
                    <div class="ring-label">
                        <span class="ring-score" aria-label="@($"Strangeness {_comic.StrangenessScore} out of 100")">@_revealedScore</span>
                        <span class="ring-text">Weird</span>
                    </div>
                    @* Ink-splatter burst (FX #4), fired when the count lands. Sized to the score. *@
                    <canvas @ref="_burstCanvas" class="fx-overlay fx-burst-canvas" aria-hidden="true"></canvas>
                </div>
            </div>

            <ComicStrip ImageUrl="@_comic.BlobUrl"
                        RestaurantName="@_comic.RestaurantName" />

            @if (_comic.Receipts.Count > 0)
            {
                <section class="receipts @(_receiptsVisible ? "receipts-visible" : "")" aria-live="polite">
                    <h2 class="receipts-title">Why @_comic.StrangenessScore?</h2>
                    <ul class="receipt-list">
                        @foreach (var receipt in _comic.Receipts)
                        {
                            <li class="receipt">
                                <blockquote class="receipt-quote">@receipt.Quote</blockquote>
                                <span class="receipt-points">+@receipt.Points</span>
                            </li>
                        }
                    </ul>
                    <p class="receipt-note">Quoted verbatim from public Google reviews.</p>
                </section>
            }

            <p class="comic-supporting-copy">Share the panel, or reopen discovery to find the next strange story.</p>
            <p class="comic-source-note">Drawn from a small sample of recent public Google reviews — not the restaurant's full history.</p>

            <div class="action-buttons">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn btn-primary" Disabled="@(_isSharing || _isRegenerating)" Click="@(_ => ShareComic())">
                    @if (_isSharing)
                    {
                        <text>Sharing...</text>
                    }
                    else if (_shareSupported)
                    {
                        <text>Share Comic</text>
                    }
                    else
                    {
                        <text>Copy Link</text>
                    }
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Base" class="btn btn-secondary" Disabled="@(_isSharing || _isRegenerating)" Click="@(_ => GoBack())">
                    &#8592; @(From == "leaderboard" ? "Back to Hall of Fame" : "Find Another")
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" class="btn btn-secondary" Disabled="@(_isRegenerating || _isSharing)" Click="@(_ => RegenerateComic())">
                    Try Another Version
                </RadzenButton>
            </div>
            
            @if (_showCopiedMessage)
            {
                <div class="alert alert-success copied-message" role="status">
                    &#10003; Link copied to clipboard!
                </div>
            }
        </RadzenCard>
    }
</div>

@code {
    [Parameter]
    public string PlaceId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "generate")]
    public bool Generate { get; set; }

    private ComicDto? _comic;
    private bool _needsGeneration;
    private bool _isLoading = true;
    private bool _isSharing = false;
    private bool _isRegenerating = false;
    private bool _shareSupported = false;
    private bool _showCopiedMessage = false;
    private string? _error;
    private string _errorTitle = "Oops!";
    private Timer? _copiedMessageTimer;
    private Timer? _scoreRevealTimer;

    /// <summary>Score currently painted in the ring while it counts up to the real one.</summary>
    private int _revealedScore;
    private bool _receiptsVisible;

    /// <summary>Pipeline stage the server last reported, as an index into the step arrays.</summary>
    private int _activeStepIndex;

    private ElementReference _burstCanvas;
    private bool _burstFired;

    // Aligned one-to-one with the phases the API streams. The order here IS the progress
    // order, so a new pipeline phase must be added in both places or the stepper misreports.
    private static readonly ComicGenerationPhase[] _phaseOrder =
    [
        ComicGenerationPhase.FetchingReviews,
        ComicGenerationPhase.AnalyzingStrangeness,
        ComicGenerationPhase.GeneratingArtwork,
        ComicGenerationPhase.ComposingStrip,
        ComicGenerationPhase.Publishing,
    ];

    private static readonly (string Icon, string Label)[] _comicSteps =
    [
        ("🔍", "Reading the reviews..."),
        ("🧠", "Scoring the strangeness..."),
        ("🎨", "Drawing the panels..."),
        ("✍️", "Lettering the captions..."),
        ("📮", "Publishing your strip..."),
    ];

    private static readonly (string Icon, string Label)[] _regenerateSteps =
    [
        ("🔍", "Re-reading the reviews..."),
        ("🧠", "Finding a new angle..."),
        ("🎨", "Redrawing the panels..."),
        ("✍️", "Re-lettering the captions..."),
        ("📮", "Publishing the new take..."),
    ];

    // Both recovery cards leave the comic entirely, so they must name the same destination
    // GoBack() actually navigates to.
    private string BackLabel => From == "leaderboard" ? "Back to Hall of Fame" : "Back to Restaurants";

    /// <summary>Circumference of the r=42 score ring: 2 * PI * 42.</summary>
    private const double RingCircumference = 263.89;

    private string RingDashArray
    {
        get
        {
            var filled = _revealedScore / 100.0 * RingCircumference;
            return $"{filled.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} "
                 + RingCircumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Viewing is read-only: try the cached comic first (GET, free). Generation (POST,
        // paid AI pipeline) only runs when the user explicitly asked for it — the search
        // flow navigates with ?generate=true; Hall of Fame / shared links never auto-spend.
        try
        {
            _comic = await ApiClient.GetCachedComicAsync(PlaceId);
        }
        catch (Exception)
        {
            // Fall through: treat lookup failure like a cache miss.
        }

        if (_comic == null)
        {
            if (Generate)
            {
                await LoadComic(forceRegenerate: false);
            }
            else
            {
                _needsGeneration = true;
                _isLoading = false;
            }
        }
        else
        {
            _isLoading = false;
            StartScoreReveal();
        }

        _shareSupported = await ShareService.IsShareSupportedAsync();
    }

    /// <summary>
    /// Counts the ring up to the real score instead of printing it. The score is the payoff of
    /// a ten-second wait; landing it as a static integer wastes the only dramatic beat the app
    /// has. Receipts fade in once the count lands, so the number arrives before its evidence.
    /// </summary>
    private void StartScoreReveal()
    {
        var target = _comic?.StrangenessScore ?? 0;

        _scoreRevealTimer?.Dispose();
        _revealedScore = 0;
        _receiptsVisible = false;
        _burstFired = false;

        if (target <= 0)
        {
            _receiptsVisible = true;
            return;
        }

        // Fixed duration rather than fixed step size, so a 12 and a 97 both take ~900ms.
        var step = Math.Max(1, (int)Math.Ceiling(target / (RevealDurationMs / (double)RevealTickMs)));

        _scoreRevealTimer = new Timer(_ =>
        {
            _revealedScore = Math.Min(target, _revealedScore + step);
            var landed = _revealedScore >= target;

            if (landed)
            {
                _receiptsVisible = true;
                _scoreRevealTimer?.Change(Timeout.Infinite, Timeout.Infinite);
            }

            InvokeAsync(async () =>
            {
                StateHasChanged();

                // Interop must run on the renderer's context, not the timer thread.
                if (landed)
                {
                    await OnScoreLandedAsync(target);
                }
                else
                {
                    await Fx.PlayScoreTickAsync(_revealedScore, target);
                }
            });
        }, null, RevealTickMs, RevealTickMs);
    }

    private const int RevealDurationMs = 900;
    private const int RevealTickMs = 30;

    /// <summary>
    /// The payoff beat: resolving chord voiced by score, an ink splatter sized to it, and the
    /// backdrop retuned to match. Guarded by <c>_burstFired</c> so a re-render cannot replay it.
    /// </summary>
    private async Task OnScoreLandedAsync(int score)
    {
        if (_burstFired)
        {
            return;
        }
        _burstFired = true;

        await Fx.PlayScoreLandAsync(score);
        await Fx.PlaySplatAsync(score / 100.0);
        await Fx.BurstParticlesAsync(_burstCanvas, score);

        // Tint the app-wide backdrop to this comic (FX #2).
        Layout.MainLayout.RaiseScoreChanged(score);
    }

    private async Task GenerateFromPromptAsync()
    {
        _needsGeneration = false;
        await LoadComic(forceRegenerate: false);
    }

    public ValueTask DisposeAsync()
    {
        _copiedMessageTimer?.Dispose();
        _scoreRevealTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task LoadComic(bool forceRegenerate)
    {
        _isLoading = true;
        _error = null;
        _activeStepIndex = 0;
        StateHasChanged();

        try
        {
            // Streamed so the stepper reflects the stage the pipeline is genuinely in. The
            // reported phase is mapped through _phaseOrder rather than cast, so an unknown
            // phase from a newer API leaves the stepper where it is instead of jumping.
            var progress = new Progress<ComicGenerationPhase>(phase =>
            {
                var index = Array.IndexOf(_phaseOrder, phase);
                if (index >= 0)
                {
                    _activeStepIndex = index;
                    StateHasChanged();
                }
            });

            _comic = await ApiClient.GenerateComicStreamAsync(PlaceId, forceRegenerate, progress);
            StartScoreReveal();
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _errorTitle = "No Reviews to Draw From! 📭";
                _error = "We couldn't find any usable reviews for this restaurant, so there's nothing to build a comic out of. Try another place!";
            }
            else if (ex.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
            {
                _errorTitle = "Too Normal for a Comic! 😌";
                _error = string.IsNullOrWhiteSpace(ex.Message)
                    ? "This restaurant's reviews are too ordinary to make a good comic. Try a place with weirder reviews!"
                    : ex.Message;
            }
            else if (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _errorTitle = "Whoa, Slow Down! 🚦";
                _error = "You're generating comics faster than we can draw them. Please wait about a minute and try again.";
            }
            else if (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _errorTitle = "Restaurant Not Found";
                _error = "We couldn't find this restaurant. It might have closed or the Google Maps data is unavailable.";
            }
            else
            {
                _errorTitle = "Generation Failed";
                _error = $"Something went wrong while generating the comic. Please try again in a moment. ({ex.Message})";
            }
        }
        catch (Exception ex)
        {
            _errorTitle = "Unexpected Error";
            _error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            if (_error is not null)
            {
                await Fx.PlayErrorAsync();
            }
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo(From == "leaderboard" ? "/leaderboard" : "/");
    }

    private async Task RegenerateComic()
    {
        // Every button press is a trusted gesture, which is the only context in which a browser
        // will let an AudioContext leave 'suspended'.
        await Fx.UnlockAudioAsync();
        await Fx.PlayTapAsync();

        _isRegenerating = true;
        StateHasChanged();
        try
        {
            await LoadComic(forceRegenerate: true);
        }
        finally
        {
            _isRegenerating = false;
            StateHasChanged();
        }
    }

    private async Task ShareComic()
    {
        if (_comic == null) return;

        _isSharing = true;
        StateHasChanged();

        try
        {
            var currentUrl = Navigation.Uri;
            var title = $"Strange Review Comic - {_comic.RestaurantName}";
            var text = $"Check out this weird review comic! Strangeness: {_comic.StrangenessScore}/100 🎨 #PoSeeReview";

            if (_shareSupported)
            {
                var outcome = await ShareService.ShareComicAsync(title, text, currentUrl);

                // Cancelling is a decision, not a failure: falling back to a clipboard copy
                // would hand the user a link they just declined to share.
                if (outcome == ShareOutcome.Unsupported)
                {
                    Logger.LogWarning("Web Share unavailable at call time, copying link instead");
                    await CopyLinkToClipboard(currentUrl);
                }
                else if (outcome == ShareOutcome.Shared)
                {
                    // Only on a real completion. Sounding a cancel would reward the one outcome
                    // the user chose against, and the sheet is still animating away on mobile.
                    await Fx.PlayShareStingerAsync();
                }
            }
            else
            {
                // Fallback to clipboard copy
                await CopyLinkToClipboard(currentUrl);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sharing comic");
            // Silently fail - user experience shouldn't be disrupted
        }
        finally
        {
            _isSharing = false;
            StateHasChanged();
        }
    }

    private async Task CopyLinkToClipboard(string url)
    {
        try
        {
            await ShareService.CopyToClipboardAsync(url);
            await Fx.PlayShareStingerAsync();
            _showCopiedMessage = true;
            StateHasChanged();

            // Hide message after 3 seconds
            _copiedMessageTimer?.Dispose();
            _copiedMessageTimer = new Timer(_ =>
            {
                _showCopiedMessage = false;
                InvokeAsync(StateHasChanged);
            }, null, 3000, Timeout.Infinite);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying to clipboard");
        }
    }



}
