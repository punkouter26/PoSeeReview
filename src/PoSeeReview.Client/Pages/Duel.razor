@page "/duel/{A}/{B}"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ApiClient ApiClient
@inject FxService Fx

<PageTitle>Duel - PoSeeReview</PageTitle>

<PageShell Title="Which is stranger?" Width="PageShell.ShellWidth.Narrow">
    @if (_failed)
    {
        <StateCard Icon="⚔️" Title="This duel is over">
            <ChildContent>One of these comics has expired or been withdrawn, so there is nothing to compare.</ChildContent>
            <Actions><a href="/" class="btn btn-primary">Find restaurants</a></Actions>
        </StateCard>
    }
    else
    {
        @* The card is drawn by the server (the same image a link preview shows); width and
           height reserve its box before it loads. *@
        @* The stage carries the clash in CSS: the slam, a shake, a seam and a wash over the
           winning half. data-clash is set once the card has loaded, so nothing slams onto an
           empty box. *@
        <div class="duel-stage" data-clash="@(_clash ? "on" : "off")"
             data-winner="@Winner">
            <img class="duel-card" width="1200" height="630"
                 src="@($"/share/duel/{Uri.EscapeDataString(A)}/{Uri.EscapeDataString(B)}/card.png")"
                 alt="@($"{NameOf(_a, "The first comic")} versus {NameOf(_b, "the second comic")}, side by side with their strangeness scores")"
                 @onload="OnCardLoadedAsync"
                 @onerror="() => _failed = true" />
        </div>
        <div class="duel-links">
            <a class="btn btn-secondary" href="@($"/comic/{Uri.EscapeDataString(A)}")">@NameOf(_a, "First comic")</a>
            <a class="btn btn-secondary" href="@($"/comic/{Uri.EscapeDataString(B)}")">@NameOf(_b, "Second comic")</a>
        </div>
    }
</PageShell>

@code {
    [Parameter] public string A { get; set; } = string.Empty;
    [Parameter] public string B { get; set; } = string.Empty;

    private ComicDto? _a;
    private ComicDto? _b;
    private bool _failed;
    private bool _clash;
    private bool _cardLoaded;

    /// <summary>Which half is stranger; the CSS floods that side. Empty until both scores are known.</summary>
    private string Winner => (_a, _b) switch
    {
        ({ } a, { } b) when a.StrangenessScore > b.StrangenessScore => "left",
        ({ } a, { } b) when a.StrangenessScore < b.StrangenessScore => "right",
        ({ }, { }) => "tie",
        _ => ""
    };

    /// <summary>The names on the two links and the scores the clash leans on; the page works without them.</summary>
    protected override async Task OnParametersSetAsync()
    {
        _failed = false;
        (_a, _b) = (await TryGetAsync(A), await TryGetAsync(B));
        await ClashAsync();
    }

    private async Task OnCardLoadedAsync()
    {
        _cardLoaded = true;
        await ClashAsync();
    }

    /// <summary>
    /// Clashes once the card is on screen AND both scores are known — the wash needs the winner.
    /// Either can finish first (a cached card beats the two reads), so both call this. A duel
    /// whose comics could not be read keeps the plain card. The winner's own motif sounds it out.
    /// </summary>
    private async Task ClashAsync()
    {
        if (!_cardLoaded || _a is null || _b is null || _clash)
        {
            return;
        }

        _clash = true;
        var winner = _b.StrangenessScore > _a.StrangenessScore ? _b : _a;
        await Fx.PlaySignatureAsync(winner.PlaceId, winner.StrangenessScore);
    }

    private async Task<ComicDto?> TryGetAsync(string placeId)
    {
        try
        {
            return await ApiClient.GetCachedComicAsync(placeId);
        }
        catch (HttpRequestException)
        {
            return null;   // Withheld (451) or unreachable; the image's own failure says so.
        }
    }

    private static string NameOf(ComicDto? comic, string fallback) =>
        string.IsNullOrWhiteSpace(comic?.RestaurantName) ? fallback : comic.RestaurantName;
}
