@page "/diagnostics"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ApiClient ApiClient
@inject DevSessionClient DevSessionClient
@inject ILogger<Diagnostics> Logger
@inject IJSRuntime JSRuntime
@inject FxService Fx
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Diagnostics - PoSeeReview</PageTitle>

@if (HostEnvironment.Environment != "Development")
{
    <PageShell Title="Diagnostics" Width="PageShell.ShellWidth.Narrow" Class="diagnostics-container">
        <p>This page is only available in development environments.</p>
        <a href="/" class="btn btn-secondary">← Back to Home</a>
    </PageShell>
}
else
{
<PageShell Title="System Diagnostics"
           Subtitle="Real-time health status of all application dependencies"
           Width="PageShell.ShellWidth.Wide"
           Class="diagnostics-container">

    @* ── Frame budget harness (FX #5) ─────────────────────────────────────────────────────
       "Sustains 60+ FPS" is a claim, and this is the only thing in the app that can check it.
       Numbers come from the one shared scheduler in gfx-core, so they cover every effect at
       once rather than whichever one happens to be instrumented. *@
    <section class="fx-panel glass">
        <h2>Graphics &amp; audio</h2>

        <div class="fx-stat-grid">
            <div class="fx-stat @(_stats.Fps >= 58 ? "fx-good" : _stats.Fps >= 45 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@_stats.Fps.ToString("F0")</span>
                <span class="fx-stat-label">FPS</span>
            </div>
            <div class="fx-stat @(_stats.FrameMs <= 20 ? "fx-good" : "fx-bad")">
                <span class="fx-stat-value">@_stats.FrameMs.ToString("F1")</span>
                <span class="fx-stat-label">mean frame ms</span>
            </div>
            <div class="fx-stat @(_stats.WorstFrameMs <= 34 ? "fx-good" : "fx-warn")">
                <span class="fx-stat-value">@_stats.WorstFrameMs.ToString("F1")</span>
                <span class="fx-stat-label">worst frame ms</span>
            </div>
            <div class="fx-stat @(_stats.SampledFrames > 0 && _stats.DroppedFrames * 100.0 / _stats.SampledFrames > 5 ? "fx-bad" : "fx-good")">
                <span class="fx-stat-value">@_stats.DroppedFrames</span>
                <span class="fx-stat-label">over 20ms budget</span>
            </div>
            <div class="fx-stat">
                <span class="fx-stat-value">@_stats.ActiveTasks</span>
                <span class="fx-stat-label">active effects</span>
            </div>
            <div class="fx-stat">
                <span class="fx-stat-value">@_stats.SampledFrames</span>
                <span class="fx-stat-label">frames sampled</span>
            </div>

            @* ── Beyond frame time ────────────────────────────────────────────────────────
               A frame-time average says the page is slow; none of it says why. These do.
               Anything the platform does not expose renders an em dash, never a zero — an
               absent measurement and a measurement of zero are different claims, and reporting
               "0ms GPU" on a browser with no timer extension is just a lie. *@
            <div class="fx-stat @(_stats.CpuMs <= 8 ? "fx-good" : _stats.CpuMs <= 16 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@_stats.CpuMs.ToString("F1")</span>
                <span class="fx-stat-label">cpu in effects ms</span>
            </div>
            <div class="fx-stat @(_stats.GpuMs is null ? "" : _stats.GpuMs <= 8 ? "fx-good" : _stats.GpuMs <= 16 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@(_stats.GpuMs?.ToString("F1") ?? "—")</span>
                <span class="fx-stat-label">gpu ms</span>
            </div>
            <div class="fx-stat @(_stats.HeapMb is null ? "" : _stats.HeapMb <= 220 ? "fx-good" : _stats.HeapMb <= 400 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@(_stats.HeapMb?.ToString("F0") ?? "—")</span>
                <span class="fx-stat-label">js heap mb</span>
            </div>
            <div class="fx-stat @(_stats.WorstLongTaskMs <= 100 ? "fx-good" : _stats.WorstLongTaskMs <= 250 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@_stats.LongTasks</span>
                <span class="fx-stat-label">long tasks (worst @_stats.WorstLongTaskMs.ToString("F0")ms)</span>
            </div>
            <div class="fx-stat @(_stats.InpMs is null ? "" : _stats.InpMs <= 200 ? "fx-good" : _stats.InpMs <= 500 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@(_stats.InpMs?.ToString("F0") ?? "—")</span>
                <span class="fx-stat-label">worst interaction ms</span>
            </div>
            <div class="fx-stat @(_stats.LayoutShift <= 0.1 ? "fx-good" : _stats.LayoutShift <= 0.25 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@_stats.LayoutShift.ToString("F3")</span>
                <span class="fx-stat-label">layout shift</span>
            </div>
            @* Creep here across navigations is a context leak, which ends in the browser
               silently evicting the oldest context and an effect going dark for no visible
               reason. It is invisible in every frame-time metric. *@
            <div class="fx-stat @(_stats.GlContexts <= 3 ? "fx-good" : _stats.GlContexts <= 6 ? "fx-warn" : "fx-bad")">
                <span class="fx-stat-value">@_stats.GlContexts</span>
                <span class="fx-stat-label">webgl contexts (@_stats.GlSurfaces surfaces)</span>
            </div>
        </div>

        <div class="fx-controls">
            <div class="fx-control-row">
                <span class="fx-control-label">Effects tier</span>
                <div class="fx-tier-buttons" role="group" aria-label="Effects tier">
                    @foreach (var tier in new[] { FxTier.Off, FxTier.Lite, FxTier.Full })
                    {
                        <button type="button"
                                class="btn @(_caps.Tier == tier ? "btn-primary" : "btn-secondary")"
                                disabled="@_caps.ReducedMotion"
                                @onclick="() => SetTierAsync(tier)">
                            @tier
                        </button>
                    }
                </div>
            </div>

            <div class="fx-control-row">
                <span class="fx-control-label">Sound</span>
                <button type="button" class="btn @(_audioEnabled ? "btn-primary" : "btn-secondary")"
                        @onclick="ToggleAudioAsync">
                    @(_audioEnabled ? "On" : "Off")
                </button>
            </div>

            <div class="fx-control-row">
                <span class="fx-control-label">Live overlay</span>
                <button type="button" class="btn @(_perfHudVisible ? "btn-primary" : "btn-secondary")"
                        @onclick="TogglePerfHudAsync">
                    @(_perfHudVisible ? "On" : "Off")
                </button>
            </div>

            <div class="fx-control-row">
                <button type="button" class="btn btn-secondary" @onclick="ResetStatsAsync">Reset counters</button>
            </div>
        </div>

        <ul class="fx-notes">
            <li>WebGL2: <strong>@(_caps.WebGl2 ? "available" : "unavailable")</strong></li>
            @* The overlay is the instrument that matters, because this page is not the page that
               is slow. It draws from inside the same rAF loop the effects run on, so it measures
               the frames it is part of rather than polling across interop like this grid does. *@
            <li>
                The live overlay works on <em>every</em> page — toggle it with
                <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>F</kbd>, or append <code>?fx=debug</code> to any URL.
                Watch it on the comic page, not here: this one runs no effects.
            </li>
            @if (_audioLatency is { } latency)
            {
                <li>
                    Audio: <strong>@latency.ContextState</strong> at @latency.SampleRate.ToString("F0") Hz,
                    @((latency.BaseMs + latency.OutputMs).ToString("F1"))ms output latency.
                </li>
            }
            @if (_stats.ContextLosses > 0)
            {
                <li class="fx-bad">
                    <strong>@_stats.ContextLosses WebGL context loss(es).</strong> The shared atlas was
                    dropped by the driver; effects fell back to private contexts. Usually a GPU reset
                    or a background tab being reclaimed, not an app bug — but repeated losses on one
                    device mean the scene is too heavy for it.
                </li>
            }
            @if (_caps.ReducedMotion)
            {
                <li><strong>The OS asked for reduced motion.</strong> The tier is pinned to Off and the control above is disabled — offering a toggle that ignores the system preference would be worse than hiding it.</li>
            }
            @if (_caps.AutoDowngraded)
            {
                <li class="fx-bad"><strong>Auto-downgraded.</strong> Frame time stayed over budget for ~1.5s, so the watchdog dropped a tier. This is not persisted; a reload restores your choice.</li>
            }
        </ul>
    </section>

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Checking system health...</p>
        </div>
    }
    else if (healthStatus == null)
    {
        <div class="alert alert-danger">
            <h3>Unable to retrieve health status</h3>
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadHealthStatus">Retry</button>
        </div>
    }
    else
    {
        <div class="health-summary @GetStatusClass(healthStatus.Status)">
            <div class="status-icon">@GetStatusIcon(healthStatus.Status)</div>
            <div class="status-details">
                <h2>Overall Status: @healthStatus.Status</h2>
                <p><strong>Checked:</strong> @healthStatus.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
                <p><strong>Duration:</strong> @healthStatus.DurationMilliseconds.ToString("F0") ms</p>
                <p><strong>Current User:</strong> @(diagnosticsSnapshot?.CurrentUserId ?? devSession?.UserId ?? "anonymous")</p>
            </div>
        </div>

        @if (devSession != null)
        {
            <div class="diagnostics-section">
                <h3>Development Session</h3>
                <div class="key-grid">
                    <div class="key-card @(devSession.UserId?.StartsWith("ANON") == true ? "key-present" : "")">
                        <div class="key-name">User</div>
                        <div class="key-value">@devSession.UserId</div>
                    </div>
                    <div class="key-card">
                        <div class="key-name">Anonymous</div>
                        <div class="key-value">@devSession.IsAnonymous</div>
                    </div>
                    <div class="key-card">
                        <div class="key-name">Dev Bypass</div>
                        <div class="key-value">@devSession.IsDevelopmentBypass</div>
                    </div>
                    <div class="key-card @(_storageKeyPresent ? "key-present" : "key-missing")">
                        <div class="key-name">localStorage key</div>
                        <div class="key-value">@(_storageKeyPresent ? "posee_dev_session ✓" : "absent")</div>
                    </div>
                    @if (devSession.CreatedAtUtc != default)
                    {
                        <div class="key-card">
                            <div class="key-name">Created</div>
                            <div class="key-value">@devSession.CreatedAtUtc.ToString("HH:mm:ss UTC")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="health-checks">
            <h3>Dependency Health Checks</h3>
            @foreach (var check in healthStatus.Checks)
            {
                <div class="health-check-card @GetStatusClass(check.Status)">
                    <div class="check-header">
                        <span class="check-icon">@GetStatusIcon(check.Status)</span>
                        <h4>@FormatCheckName(check.Name)</h4>
                        <span class="check-status">@check.Status</span>
                    </div>
                    <div class="check-body">
                        <p class="check-description">@check.Description</p>
                        <div class="check-meta">
                            <span><strong>Duration:</strong> @check.DurationMilliseconds.ToString("F0") ms</span>
                            @if (!string.IsNullOrEmpty(check.Exception))
                            {
                                <details>
                                    <summary class="error-summary">Error Details</summary>
                                    <pre class="error-details">@check.Exception</pre>
                                </details>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (diagnosticsSnapshot != null)
        {
            <div class="diagnostics-section">
                <h3>Runtime Snapshot</h3>
                <div class="key-grid">
                    <div class="key-card"><div class="key-name">Environment</div><div class="key-value">@diagnosticsSnapshot.Environment</div></div>
                    <div class="key-card"><div class="key-name">Machine</div><div class="key-value">@diagnosticsSnapshot.MachineName</div></div>
                    <div class="key-card"><div class="key-name">.NET</div><div class="key-value">@diagnosticsSnapshot.DotNetVersion</div></div>
                    <div class="key-card"><div class="key-name">OS</div><div class="key-value">@diagnosticsSnapshot.OsVersion</div></div>
                </div>
            </div>

            <div class="diagnostics-section">
                <h3>Critical Keys</h3>
                <div class="key-grid">
                    @foreach (var key in diagnosticsSnapshot.KeyStatus)
                    {
                        <div class="key-card @(key.Exists ? "key-present" : "key-missing")">
                            <div class="key-name">@key.Key</div>
                            <div class="key-value">@(key.Value ?? "missing")</div>
                        </div>
                    }
                </div>
            </div>

            <div class="diagnostics-section">
                <h3>Configuration Values</h3>
                <div class="config-table">
                    @foreach (var item in diagnosticsSnapshot.Config)
                    {
                        <div class="config-row">
                            <div class="config-key">@item.Key</div>
                            <div class="config-value">@item.Value</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="LoadHealthStatus">
                🔄 Refresh Status
            </button>
            <a href="/" class="btn btn-secondary">← Back to Home</a>
        </div>
    }

    @* Product funnel. The PRD sets targets — time-to-first-comic, cache hit rate above 40% —
       that nothing measured: the server only ever tracked ComicGenerated, which cannot see a
       user who denied location or abandoned a generation. These counters come from the client. *@
    <section class="funnel-panel glass">
        <h2>Today's funnel</h2>

        @if (_funnel is null)
        {
            <p class="funnel-empty">No funnel data recorded yet today.</p>
        }
        else
        {
            <div class="funnel-rates">
                <div class="funnel-rate">
                    <span class="funnel-rate-value">@FormatRate(_funnel.LocationGrantRate)</span>
                    <span class="funnel-rate-label">Location granted</span>
                </div>
                <div class="funnel-rate">
                    <span class="funnel-rate-value">@FormatRate(_funnel.TapThroughRate)</span>
                    <span class="funnel-rate-label">Tap to generate</span>
                </div>
                <div class="funnel-rate">
                    <span class="funnel-rate-value">@FormatRate(_funnel.GenerationCompletionRate)</span>
                    <span class="funnel-rate-label">Generations finished</span>
                </div>
                @* The one rate with a number attached to it in the PRD, so it is marked against
                   that target rather than left for the reader to remember. *@
                <div class="funnel-rate @CacheRateClass">
                    <span class="funnel-rate-value">@FormatRate(_funnel.CacheHitRate)</span>
                    <span class="funnel-rate-label">Cache hits (target &gt; 40%)</span>
                </div>
                <div class="funnel-rate">
                    <span class="funnel-rate-value">@FormatRate(_funnel.ShareRate)</span>
                    <span class="funnel-rate-label">Comics shared</span>
                </div>
                <div class="funnel-rate">
                    <span class="funnel-rate-value">@FormatDuration(_funnel.AverageGenerationMs)</span>
                    <span class="funnel-rate-label">Avg generation</span>
                </div>
            </div>

            <table class="funnel-table">
                <caption class="visually-hidden">Raw funnel step counts for today</caption>
                <thead>
                    <tr><th scope="col">Step</th><th scope="col">Count</th></tr>
                </thead>
                <tbody>
                    @foreach (var step in FunnelSteps.All)
                    {
                        <tr>
                            <td>@step.Replace('_', ' ')</td>
                            <td class="funnel-count">@(_funnel.Counts.TryGetValue(step, out var n) ? n : 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

</PageShell>
}

@code {
    private FxFrameStats _stats;
    private FxCapabilities _caps;
    private bool _audioEnabled;
    private bool _perfHudVisible;
    private FxAudioLatency? _audioLatency;
    private System.Threading.Timer? _statsTimer;

    /// <summary>
    /// Polls the scheduler four times a second. Deliberately not a per-frame push: an overlay
    /// that re-rendered a Blazor component every frame would itself be a source of the jank it
    /// is meant to measure.
    /// </summary>
    private async Task InitFxPanelAsync()
    {
        _caps = await Fx.GetCapabilitiesAsync();
        _audioEnabled = await Fx.IsAudioEnabledAsync();
        _perfHudVisible = await Fx.IsPerfHudVisibleAsync();

        _statsTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                _stats = await Fx.GetFrameStatsAsync();
                _caps = await Fx.GetCapabilitiesAsync();
                _audioLatency = await Fx.GetAudioLatencyAsync();
                StateHasChanged();
            });
        }, null, 250, 250);
    }

    private async Task SetTierAsync(FxTier tier)
    {
        // A button press is a trusted gesture, so this doubles as the audio unlock point.
        await Fx.UnlockAudioAsync();
        await Fx.SetTierAsync(tier);
        _caps = await Fx.GetCapabilitiesAsync();
        await Fx.ResetFrameStatsAsync();
    }

    /// <summary>
    /// The overlay is global, so this only reflects state the user could equally have toggled
    /// with the keyboard shortcut on any other page.
    /// </summary>
    private async Task TogglePerfHudAsync()
    {
        _perfHudVisible = await Fx.TogglePerfHudAsync();
    }

    private async Task ToggleAudioAsync()
    {
        _audioEnabled = await Fx.SetAudioEnabledAsync(!_audioEnabled);
        if (_audioEnabled)
        {
            await Fx.PlayScoreLandAsync(72);   // Audible confirmation that it actually works.
        }
    }

    private Task ResetStatsAsync() => Fx.ResetFrameStatsAsync();

    public ValueTask DisposeAsync()
    {
        _statsTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private bool isLoading = true;
    private HealthStatusDto? healthStatus;
    private DiagnosticsSnapshotDto? diagnosticsSnapshot;
    private DevSessionDto? devSession;
    private bool _storageKeyPresent;
    private string? errorMessage;

    private FunnelSnapshotDto? _funnel;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthStatus();
        _funnel = await ApiClient.GetFunnelSnapshotAsync();
        await InitFxPanelAsync();
    }

    /// <summary>A rate with no denominator is absent, not zero — "0%" would be a claim we cannot make.</summary>
    private static string FormatRate(double? rate) =>
        rate is null ? "--" : $"{rate.Value:F0}%";

    private static string FormatDuration(double? ms) =>
        ms is null ? "--" : $"{ms.Value / 1000:F1}s";

    /// <summary>Marks the cache hit rate against the PRD's stated 40% target.</summary>
    private string CacheRateClass => _funnel?.CacheHitRate switch
    {
        null => string.Empty,
        >= 40 => "funnel-rate--good",
        _ => "funnel-rate--warn"
    };

    private async Task LoadHealthStatus()
    {
        isLoading = true;
        errorMessage = null;
        healthStatus = null;

        try
        {
            Logger.LogInformation("Fetching development diagnostics payloads");
            var healthTask = ApiClient.GetHealthStatusAsync();
            var diagnosticsTask = ApiClient.GetDiagnosticsSnapshotAsync();
            var sessionTask = DevSessionClient.GetCurrentSessionAsync(refreshFromServer: true);

            await Task.WhenAll(healthTask, diagnosticsTask, sessionTask);

            healthStatus = healthTask.Result;
            diagnosticsSnapshot = diagnosticsTask.Result;
            devSession = sessionTask.Result;
            var rawKey = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "posee_dev_session");
            _storageKeyPresent = !string.IsNullOrEmpty(rawKey);
            Logger.LogInformation("Health status retrieved: {Status}", healthStatus?.Status);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Failed to fetch health status");
            errorMessage = $"HTTP error: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error fetching health status");
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "status-healthy",
        "degraded" => "status-degraded",
        "unhealthy" => "status-unhealthy",
        _ => "status-unknown"
    };

    private string GetStatusIcon(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "✓",
        "degraded" => "!",
        "unhealthy" => "✗",
        _ => "?"
    };

    private string FormatCheckName(string name) => name
        .Replace("_", " ")
        .Replace("azure", "Azure")
        .Replace("table storage", "Table Storage")
        .Replace("blob storage", "Blob Storage")
        .Replace("google maps api", "Google Maps API")
        .Replace("openai", "OpenAI");

}
