@page "/"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using Microsoft.JSInterop
@using System.Net
@inject GeolocationService GeolocationService
@inject IJSRuntime JS
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject FxService Fx
@inject AnalyticsService Analytics

<PageTitle>PoSeeReview - Discover Strange Restaurant Stories</PageTitle>

<div class="index-container">
    @* One line of hero, and it says what the app does — the nav already carries the wordmark.
       Hidden once results are showing; the page keeps its h1 either way. *@
    @if (_restaurants.Count == 0)
    {
        <header class="app-header">
            <h1>Turn a restaurant's wildest reviews into a comic</h1>
        </header>
    }
    else
    {
        <h1 class="visually-hidden">PoSeeReview</h1>
    }

    @* The error sits ABOVE the search bar, and the bar stays mounted in the Error state — a failed
       text search must leave the user their search box, not a lone "Try again" link. *@
    @if (_flowState == LocationFlowState.Error)
    {
        <div class="alert alert-danger error-message" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="btn btn-secondary retry-link" @onclick="RetryLastAttemptAsync">@RetryLabel</button>
        </div>
    }

    @* One search bar: location, text field, submit. It replaces a card with an eyebrow, a heading,
       a paragraph, an "or" divider and a hint line — five lines of instructions for two controls.
       Rendered while the location request is in flight too: the escape hatch ("or type a city")
       must not vanish while a browser permission prompt sits unanswered. *@
    @if (_flowState is LocationFlowState.Idle or LocationFlowState.Denied
                         or LocationFlowState.Error or LocationFlowState.Loading)
    {
        <div class="location-prompt glass">
            <div class="search-row">
                @if (_flowState != LocationFlowState.Denied)
                {
                    <button type="button" class="btn btn-primary location-btn"
                            disabled="@(_flowState == LocationFlowState.Loading)"
                            @onclick="RequestLocationAsync"
                            title="Use my location" aria-label="Use my location">
                        <span aria-hidden="true">📍</span>
                        <span class="location-btn-label">@(_flowState == LocationFlowState.Loading ? "Finding you..." : "Near me")</span>
                    </button>
                }
                <label for="city-search-input" class="visually-hidden">Search city, address, or ZIP code</label>
                <input id="city-search-input" class="search-field" type="search" autocomplete="off" enterkeyhint="search"
                       @bind="_searchQuery" @bind:event="oninput" placeholder="@_searchPlaceholder" @onkeydown="HandleSearchKeyDown" />
                <button type="button" class="btn btn-secondary"
                        @onclick="SearchByLocationAsync"
                        disabled="@string.IsNullOrWhiteSpace(_searchQuery)"
                        title="@(string.IsNullOrWhiteSpace(_searchQuery) ? "Type a city, address, or ZIP code first" : "Search this location")">
                    Search
                </button>
            </div>
            @if (_flowState == LocationFlowState.Denied)
            {
                <p class="denied-alert" role="alert">
                    📍 Location access was denied — search above, or
                    <button type="button" class="link-button" @onclick="RequestLocationAsync">try location again</button>.
                </p>
            }
        </div>
    }

    @if (_flowState == LocationFlowState.Loading)
    {
        <p class="results-info" role="status">@_loadingMessage</p>
        <div class="restaurants-grid" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton-card">
                    <div class="sk-row">
                        <div class="sk-block sk-title"></div>
                        <div class="sk-block sk-badge"></div>
                    </div>
                    <div class="sk-block sk-address"></div>
                    <div class="sk-block sk-btn"></div>
                </div>
            }
        </div>
    }

    @if (_restaurants.Count > 0)
    {
        <div class="results-header">
            <button type="button" class="btn btn-secondary new-search-btn" @onclick="ClearSearch"
                    title="Search a different area">
                <span aria-hidden="true">&#215;</span> New search
            </button>
            <span class="results-count">@_restaurants.Count restaurant@(_restaurants.Count == 1 ? "" : "s") found</span>
        </div>
        <div class="restaurants-grid">
            @foreach (var restaurant in _restaurants)
            {
                <RestaurantCard
                    Restaurant="restaurant"
                    IsCached="@_cachedPlaceIds.Contains(restaurant.PlaceId)"
                    IsLoading="@(_isNavigatingToComic && _activeComicPlaceId == restaurant.PlaceId)"
                    OnRestaurantClick="HandleRestaurantClick" />
            }
        </div>
    }

    @* The fold used to be blank below the search bar. The live top three show a first-time
       visitor what the app makes before they have to share a location. *@
    @if (_flowState is LocationFlowState.Idle or LocationFlowState.Denied && _topComics is { Count: > 0 })
    {
        <section class="landing-board" aria-labelledby="landing-board-title">
            <div class="landing-board-head">
                <h2 id="landing-board-title" class="comic-rows-heading">Strangest right now</h2>
                <a href="/leaderboard">Hall of Fame →</a>
            </div>
            <ol class="comic-rows">
                @foreach (var entry in _topComics)
                {
                    <ComicRow Href="@($"/comic/{entry.PlaceId}")"
                              Name="@entry.RestaurantName"
                              Score="@((int)Math.Round(entry.StrangenessScore))"
                              ImageUrl="@ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId)"
                              Meta="@entry.Address" />
                }
            </ol>
        </section>
    }
</div>

@code {
    private enum LocationFlowState { Idle, Loading, Denied, Error, Ready }

    /// <summary>Which entry point produced the current results, so a retry repeats it.</summary>
    private enum DiscoveryAttempt { None, Location, Search }

    private LocationFlowState _flowState = LocationFlowState.Idle;
    private DiscoveryAttempt _lastAttempt = DiscoveryAttempt.None;
    private string _loadingMessage = "Getting your location...";
    private string _errorMessage = string.Empty;
    private List<RestaurantDto> _restaurants = new();
    private string _searchQuery = string.Empty;
    private string _searchPlaceholder = "City or ZIP";
    private string _lastSearch = string.Empty;
    private bool _isNavigatingToComic;
    private string? _activeComicPlaceId;

    private HashSet<string> _cachedPlaceIds = [];
    private List<LeaderboardEntryDto>? _topComics;

    /// <summary>
    /// Asks which of the current results are already drawn.
    /// <para>
    /// A cached comic opens instantly and costs nothing, a fresh one spends a paid generation and
    /// about ten seconds.
    /// </para>
    /// </summary>
    private async Task RefreshCachedPlacesAsync()
    {
        _cachedPlaceIds = _restaurants.Count == 0
            ? []
            : await ApiClient.GetCachedPlaceIdsAsync(_restaurants.Select(r => r.PlaceId));
    }

    /// <summary>Best-effort: the landing page works without it, so a failure just hides it.</summary>
    private async Task LoadTopComicsAsync()
    {
        try
        {
            var board = await ApiClient.GetLeaderboardAsync(string.Empty, 3);
            _topComics = board?.Entries.Where(e => !string.IsNullOrWhiteSpace(e.ComicBlobUrl)).ToList();
            StateHasChanged();
        }
        catch (Exception)
        {
            _topComics = null;
        }
    }

    private const string LastSearchKey = "posee_last_search";
    private const string DiscoveryModeKey = "posee_discovery_mode";
    private const string GeoMode = "geo";
    private const string ZipMode = "zip";

    /// <summary>
    /// Resumes whichever entry point the user last completed successfully. A remembered ZIP or
    /// city is re-run and left in the box, so typing a location is a real alternative to sharing
    /// GPS rather than something the app forgets between visits. With nothing remembered the page
    /// stays Idle and requests no permission — the card is the first thing the user sees.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Analytics.Track(FunnelSteps.AppOpened);
        _ = LoadTopComicsAsync();

        var lastLocation = await JS.InvokeAsync<string?>("localStorage.getItem", LastSearchKey);
        if (!string.IsNullOrWhiteSpace(lastLocation))
        {
            _searchPlaceholder = $"Last: {lastLocation}";
        }

        switch (await JS.InvokeAsync<string?>("localStorage.getItem", DiscoveryModeKey))
        {
            case ZipMode when !string.IsNullOrWhiteSpace(lastLocation):
                _searchQuery = lastLocation!;
                await SearchByLocationAsync();
                break;
            case GeoMode:
                await RequestLocationAsync();
                break;
        }
    }

    private Task RememberDiscoveryModeAsync(string mode) =>
        JS.InvokeVoidAsync("localStorage.setItem", DiscoveryModeKey, mode).AsTask();

    /// <summary>
    /// Disarms the geolocation entry point after a refusal so the next visit does not re-prompt
    /// for a permission the browser already denied. A remembered ZIP is deliberately left intact:
    /// the user declining GPS is not the user abandoning the location they typed.
    /// </summary>
    private async Task ForgetGeoPreferenceAsync()
    {
        var mode = await JS.InvokeAsync<string?>("localStorage.getItem", DiscoveryModeKey);
        if (mode is null or GeoMode)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", DiscoveryModeKey);
        }
    }

    private string RetryLabel => _lastAttempt == DiscoveryAttempt.Search
        ? $"Search “{_lastSearch}” again"
        : "Try my location again";

    /// <summary>
    /// Repeats whichever discovery path failed. Retrying a failed text search by asking for
    /// geolocation — what the old single "Try again" link did — is a different action than
    /// the one the user took.
    /// </summary>
    private Task RetryLastAttemptAsync() => _lastAttempt == DiscoveryAttempt.Search
        ? SearchByLocationAsync()
        : RequestLocationAsync();

    private async Task RequestLocationAsync()
    {
        // First trusted gesture on the landing page: the only moment a browser will let the
        // AudioContext start.
        await Fx.UnlockAudioAsync();
        // A ping with a delayed echo rather than a click. The gap is the whole message — a
        // request has gone out and has not come back — and a plain tap said nothing the button's
        // own press state did not already say.
        await Fx.PlayLocatingAsync();

        _lastAttempt = DiscoveryAttempt.Location;
        _flowState = LocationFlowState.Loading;
        _loadingMessage = "Getting your location...";
        StateHasChanged();

        try
        {
            var result = await GeolocationService.GetCurrentPositionAsync();

            if (!result.Success)
            {
                if (result.PermissionDenied)
                {
                    // Invisible to the server, and the single biggest drop-off in the funnel.
                    Analytics.Track(FunnelSteps.LocationDenied);
                    _flowState = LocationFlowState.Denied;
                    await ForgetGeoPreferenceAsync();
                }
                else
                {
                    Fail(result.ErrorMessage);
                }

                return;
            }

            Analytics.Track(FunnelSteps.LocationGranted);
            await RememberDiscoveryModeAsync(GeoMode);

            _loadingMessage = "Finding nearby restaurants...";
            StateHasChanged();

            await LoadNearbyRestaurantsAsync(result.Latitude, result.Longitude);
        }
        catch (Exception)
        {
            Fail("Unable to access your location. Please try again.");
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    private async Task LoadNearbyRestaurantsAsync(double latitude, double longitude)
    {
        try
        {
            var response = await ApiClient.GetNearbyRestaurantsAsync(latitude, longitude);

            if (response == null)
            {
                await FailEmptyAsync("No restaurants found nearby. Try a different location.");
                return;
            }

            if (response.Stale)
            {
                // Dev short-circuit or upstream unavailable — explain the why instead of "no results".
                Fail(response.StaleReason
                    ?? "Restaurant search is temporarily unavailable. " +
                       "Add a real Google Maps API key to appsettings.Development.json to enable nearby search.");
                return;
            }

            if (response.Restaurants.Count == 0)
            {
                await FailEmptyAsync("No restaurants found nearby. Try a different location.");
                return;
            }

            SetRestaurantResults(response.Restaurants);
            _flowState = LocationFlowState.Ready;
            await AfterResultsAsync();
        }
        catch (Exception ex)
        {
            Fail(DescribeFailure(ex, DiscoveryAttempt.Location, string.Empty));
        }
    }

    private async Task SearchByLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        var searchTerm = _searchQuery.Trim();

        await Fx.UnlockAudioAsync();
        await Fx.PlayLocatingAsync();

        Analytics.Track(FunnelSteps.SearchPerformed);
        _lastAttempt = DiscoveryAttempt.Search;
        _lastSearch = searchTerm;
        _flowState = LocationFlowState.Loading;
        _loadingMessage = $"Searching restaurants near {searchTerm}...";
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchRestaurantsByLocationAsync(searchTerm);

            if (response == null)
            {
                await FailEmptyAsync("No restaurants found for that location. Try a different city or ZIP code.");
                return;
            }

            // Same short-circuit the nearby path already handled. Without this a placeholder
            // Google Maps key reported "try a different city", sending the user chasing a
            // problem that has nothing to do with their query.
            if (response.Stale)
            {
                Fail(response.StaleReason
                    ?? "Restaurant search is temporarily unavailable. Please try again later.");
                return;
            }

            if (response.Restaurants.Count == 0)
            {
                await FailEmptyAsync("No restaurants found for that location. Try a different city or ZIP code.");
                return;
            }

            SetRestaurantResults(response.Restaurants);
            _flowState = LocationFlowState.Ready;
            await AfterResultsAsync();
            await JS.InvokeVoidAsync("localStorage.setItem", LastSearchKey, searchTerm);
            await RememberDiscoveryModeAsync(ZipMode);
            _searchQuery = searchTerm;
            _searchPlaceholder = $"Last: {searchTerm}";
        }
        catch (Exception ex)
        {
            Fail(DescribeFailure(ex, DiscoveryAttempt.Search, searchTerm));
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    private async Task AfterResultsAsync()
    {
        await RefreshCachedPlacesAsync();
        await Fx.PlayArrivalAsync(_restaurants.Count);
    }

    /// <summary>
    /// A search that found nothing. Distinct from <see cref="Fail"/>'s other callers because it
    /// gets the flat two-note cue rather than the error cue — a zero-result search is an answer,
    /// not a malfunction, and sounding like a malfunction sends the user looking for a fault.
    /// </summary>
    private async Task FailEmptyAsync(string message)
    {
        Fail(message);
        await Fx.PlayEmptyAsync();
    }

    /// <summary>
    /// Moves the page into the Error state with a message. Every failure path set the same two
    /// fields, and forgetting the state assignment left the banner invisible behind a spinner.
    /// </summary>
    private void Fail(string message)
    {
        _errorMessage = message;
        _flowState = LocationFlowState.Error;
    }

    /// <summary>
    /// One exception-to-copy map for both discovery paths. Nearby and search previously carried
    /// near-identical catch ladders — about seventy duplicated lines that had already drifted
    /// (only search handled 404) and would drift again on the next change.
    /// <para>
    /// Note what is deliberately absent: the old generic <c>HttpRequestException</c> arm fell back
    /// to <c>ex.Message</c>, which put raw transport exception text on screen. That is neither
    /// useful to a user nor safe to show, so every arm now returns copy this app wrote.
    /// </para>
    /// </summary>
    private static string DescribeFailure(Exception exception, DiscoveryAttempt attempt, string searchTerm) =>
        exception switch
        {
            HttpRequestException { StatusCode: HttpStatusCode.NotFound } when attempt == DiscoveryAttempt.Search =>
                $"No restaurants found near “{searchTerm}”. Try a more specific city name or ZIP code.",

            HttpRequestException { StatusCode: HttpStatusCode.ServiceUnavailable or HttpStatusCode.BadGateway } =>
                "The restaurant search service is temporarily unavailable. Please try again in a few minutes.",

            HttpRequestException { StatusCode: HttpStatusCode.TooManyRequests } =>
                "Too many requests. Please wait a moment before trying again.",

            TaskCanceledException =>
                "The request timed out. Please check your connection and try again.",

            _ when attempt == DiscoveryAttempt.Search =>
                "Failed to search restaurants. Please try again later.",

            _ => "Failed to load restaurants. Please try again later."
        };


    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchByLocationAsync();
        }
    }

    private async Task HandleRestaurantClick(RestaurantDto restaurant)
    {
        if (_isNavigatingToComic)
        {
            return;
        }

        Analytics.Track(FunnelSteps.RestaurantTapped);
        _isNavigatingToComic = true;
        _activeComicPlaceId = restaurant.PlaceId;
        // No tap cue here: RestaurantCard already played one, panned to where the tap landed.
        StateHasChanged();

        await Task.Yield();
        Navigation.NavigateTo($"/comic/{restaurant.PlaceId}?generate=true");
    }

    private void ClearSearch()
    {
        _cachedPlaceIds = [];
        _restaurants = new();
        _lastSearch = string.Empty;
        _searchQuery = string.Empty;
        _isNavigatingToComic = false;
        _activeComicPlaceId = null;
        _flowState = LocationFlowState.Idle;
    }

    private void SetRestaurantResults(IEnumerable<RestaurantDto> restaurants)
    {
        // No client-side review threshold. This used to drop anything under 5 reviews while
        // the API's ComicOptions.MinimumReviewsRequired was 1, so the client hid places the
        // server would happily draw. The only genuinely unusable case — zero reviews — is
        // handled by RestaurantCard, which matches the server's floor.
        //
        // Nearest first, unconditionally. Proximity is the only order the grid offers now that
        // the sort chips are gone, and a single order belongs where the list is built rather
        // than in a projection the render has to remember to use.
        _restaurants = [.. restaurants.OrderBy(r => r.Distance)];

        if (_restaurants.Count > 0)
        {
            Analytics.Track(FunnelSteps.ResultsShown);
        }

        if (_restaurants.Count == 0)
        {
            Fail("We couldn't find any restaurants there. Try a busier area.");
        }
    }

}
