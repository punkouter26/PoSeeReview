@page "/"
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using Microsoft.JSInterop
@inject GeolocationService GeolocationService
@inject IJSRuntime JS
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>PoSeeReview - Discover Strange Restaurant Stories</PageTitle>

<div class="index-container">
    <header class="app-header">
        <h1>PoSeeReview</h1>
        <p class="tagline">Find a place, tap once, and turn its wildest reviews into a comic.</p>
        <p class="hero-kicker">Built for quick mobile discovery and instant sharing.</p>
        <a href="/leaderboard" class="leaderboard-hero-link">🏆 Hall of Fame — See the Weirdest Stories</a>
    </header>

    @if (_flowState == LocationFlowState.Idle || _flowState == LocationFlowState.Denied)
    {
        <div class="location-prompt">
            <FluentCard class="prompt-card">
                <div class="prompt-eyebrow">Start here</div>
                <h2>Find Nearby Restaurants</h2>
                <p>Use your location for the fastest path to a comic, or type a city or ZIP code.</p>
                @if (_flowState != LocationFlowState.Denied)
                {
                    <FluentButton Appearance="Appearance.Accent" @onclick="RequestLocationAsync" class="location-btn">
                        Use My Location
                    </FluentButton>
                    <div class="divider-or"><span>or</span></div>
                }
                @if (_flowState == LocationFlowState.Denied)
                {
                    <div class="denied-alert">
                        <span class="denied-icon">📍</span>
                        <span>Location access was denied. Search manually below or <a href="#" @onclick="RequestLocationAsync" @onclick:preventDefault>try enabling location</a> again.</span>
                    </div>
                }
                <div class="search-row">
                    <FluentTextField @bind-Value="_searchQuery" Immediate="true" Placeholder="@_searchPlaceholder" @onkeydown="HandleSearchKeyDown" />
                    <FluentButton Appearance="Appearance.Neutral" @onclick="SearchByLocationAsync" Disabled="@(string.IsNullOrWhiteSpace(_searchQuery))" title="Type a city, address, or ZIP code first">
                        Search
                    </FluentButton>
                </div>
                <p class="hint-text">Only restaurants with enough review history appear, so every result is comic-ready.</p>
            </FluentCard>
        </div>
    }

    @if (_flowState == LocationFlowState.Loading)
    {
        <div class="restaurants-grid">
            <p class="results-info">@_loadingMessage</p>
            @for (var i = 0; i < 3; i++)
            {
                <div class="skeleton-card">
                    <div class="sk-row">
                        <div class="sk-block sk-title"></div>
                        <div class="sk-block sk-badge"></div>
                    </div>
                    <div class="sk-block sk-address"></div>
                    <div class="sk-row sk-footer-row">
                        <div class="sk-block sk-pill"></div>
                        <div class="sk-block sk-pill"></div>
                    </div>
                    <div class="sk-block sk-btn"></div>
                </div>
            }
        </div>
    }


    @if (_flowState == LocationFlowState.Error)
    {
        <div class="error-message">
            <h2>Something Went Wrong</h2>
            <p>@_errorMessage <a href="#" @onclick="RequestLocationAsync" @onclick:preventDefault>Try again</a></p>
        </div>
    }

    @if (_restaurants.Count > 0)
    {
        <div class="restaurants-grid">
            <div class="results-chip-bar">
                <span class="search-chip">
                    &#128205; @_lastSearch
                    <button class="chip-clear" @onclick="ClearSearch" title="New search">&#215;</button>
                </span>
                <span class="results-count">@_totalCount comic-ready restaurants</span>
            </div>
            @foreach (var restaurant in _restaurants)
            {
                <RestaurantCard
                    Restaurant="restaurant"
                    IsLoading="@(_isNavigatingToComic && _activeComicPlaceId == restaurant.PlaceId)"
                    OnRestaurantClick="HandleRestaurantClick" />
            }
        </div>
    }
</div>

@code {
    private enum LocationFlowState { Idle, Loading, Denied, Error, Ready }
    private LocationFlowState _flowState = LocationFlowState.Idle;
    private string _loadingMessage = "Getting your location...";
    private string _errorMessage = string.Empty;
    private List<RestaurantDto> _restaurants = new();
    private int _totalCount = 0;
    private string _searchQuery = string.Empty;
    private string _searchPlaceholder = "e.g. Seattle, 10001, Chicago";
    private string _lastSearch = string.Empty;
    private bool _isNavigatingToComic;
    private string? _activeComicPlaceId;

    protected override async Task OnInitializedAsync()
    {
        var lastLocation = await JS.InvokeAsync<string?>("localStorage.getItem", "posee_last_search");
        if (!string.IsNullOrWhiteSpace(lastLocation))
        {
            _searchPlaceholder = $"Last: {lastLocation}";
        }

        var storedValue = await JS.InvokeAsync<string?>("localStorage.getItem", "posee_location_enabled");
        var locationEnabled = storedValue == "true";

        if (locationEnabled)
        {
            await RequestLocationAsync();
        }
    }

    private async Task RequestLocationAsync()
    {
        _flowState = LocationFlowState.Loading;
        _loadingMessage = "Getting your location...";
        StateHasChanged();

        try
        {
            var result = await GeolocationService.GetCurrentPositionAsync();

            if (!result.Success)
            {
                if (result.ErrorMessage.Contains("denied", StringComparison.OrdinalIgnoreCase))
                {
                    _flowState = LocationFlowState.Denied;
                    await JS.InvokeVoidAsync("localStorage.setItem", "posee_location_enabled", "false");
                }
                else
                {
                    _errorMessage = result.ErrorMessage;
                    _flowState = LocationFlowState.Error;
                }

                return;
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "posee_location_enabled", "true");

            _loadingMessage = "Finding nearby restaurants...";
            StateHasChanged();

            await LoadNearbyRestaurantsAsync(result.Latitude, result.Longitude);
        }
        catch (Exception)
        {
            _errorMessage = "Unable to access your location. Please try again.";
            _flowState = LocationFlowState.Error;
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    private async Task LoadNearbyRestaurantsAsync(double latitude, double longitude)
    {
        try
        {
            var response = await ApiClient.GetNearbyRestaurantsAsync(latitude, longitude);

            if (response == null)
            {
                _errorMessage = "No restaurants found nearby. Try a different location.";
                _flowState = LocationFlowState.Error;
                return;
            }

            if (response.Stale)
            {
                // Dev short-circuit or upstream unavailable — explain the why instead of "no results".
                _errorMessage = response.StaleReason
                    ?? "Restaurant search is temporarily unavailable. " +
                       "Add a real Google Maps API key to appsettings.Development.json to enable nearby search.";
                _flowState = LocationFlowState.Error;
                return;
            }

            if (response.Restaurants.Count == 0)
            {
                _errorMessage = "No restaurants found nearby. Try a different location.";
                _flowState = LocationFlowState.Error;
                return;
            }

            SetRestaurantResults(response.Restaurants, "Nearby");
            _flowState = LocationFlowState.Ready;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
            || ex.StatusCode == System.Net.HttpStatusCode.BadGateway)
        {
            _errorMessage = "The restaurant search service is temporarily unavailable. Please try again in a few minutes.";
            _flowState = LocationFlowState.Error;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _errorMessage = "Too many requests. Please wait a moment before trying again.";
            _flowState = LocationFlowState.Error;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to load restaurants. Please try again later."
                : ex.Message;
            _flowState = LocationFlowState.Error;
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "The request timed out. Please check your connection and try again.";
            _flowState = LocationFlowState.Error;
        }
        catch (Exception)
        {
            _errorMessage = "Failed to load restaurants. Please try again later.";
            _flowState = LocationFlowState.Error;
        }
    }

    private async Task SearchByLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        var searchTerm = _searchQuery.Trim();

        _flowState = LocationFlowState.Loading;
        _loadingMessage = $"Searching restaurants near {searchTerm}...";
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchRestaurantsByLocationAsync(searchTerm);

            if (response == null || response.Restaurants.Count == 0)
            {
                _errorMessage = "No restaurants found for that location. Try a different city or ZIP code.";
                _flowState = LocationFlowState.Error;
                return;
            }

            SetRestaurantResults(response.Restaurants, searchTerm);
            _flowState = LocationFlowState.Ready;
            await JS.InvokeVoidAsync("localStorage.setItem", "posee_last_search", searchTerm);
            _searchQuery = searchTerm;
            _searchPlaceholder = $"Last: {searchTerm}";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _errorMessage = $"No restaurants found near \u201c{searchTerm}\u201d. Try a more specific city name or ZIP code.";
            _flowState = LocationFlowState.Error;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
            || ex.StatusCode == System.Net.HttpStatusCode.BadGateway)
        {
            _errorMessage = "The restaurant search service is temporarily unavailable. Please try again in a few minutes.";
            _flowState = LocationFlowState.Error;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _errorMessage = "Too many requests. Please wait a moment before trying again.";
            _flowState = LocationFlowState.Error;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to search restaurants. Please try again later."
                : ex.Message;
            _flowState = LocationFlowState.Error;
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "The request timed out. Please check your connection and try again.";
            _flowState = LocationFlowState.Error;
        }
        catch (Exception)
        {
            _errorMessage = "Failed to search restaurants. Please try again later.";
            _flowState = LocationFlowState.Error;
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchByLocationAsync();
        }
    }

    private async Task HandleRestaurantClick(RestaurantDto restaurant)
    {
        if (_isNavigatingToComic)
        {
            return;
        }

        _isNavigatingToComic = true;
        _activeComicPlaceId = restaurant.PlaceId;
        StateHasChanged();

        await Task.Yield();
        Navigation.NavigateTo($"/comic/{restaurant.PlaceId}");
    }

    private void ClearSearch()
    {
        _restaurants = new();
        _totalCount = 0;
        _lastSearch = string.Empty;
        _searchQuery = string.Empty;
        _isNavigatingToComic = false;
        _activeComicPlaceId = null;
        _flowState = LocationFlowState.Idle;
    }

    private void SetRestaurantResults(IEnumerable<RestaurantDto> restaurants, string label)
    {
        _restaurants = restaurants
            .Where(static restaurant => restaurant.TotalReviews >= 5)
            .ToList();

        _totalCount = _restaurants.Count;
        _lastSearch = label;

        if (_restaurants.Count == 0)
        {
            _errorMessage = "We found restaurants, but none have enough reviews yet to generate a comic. Try a busier area.";
            _flowState = LocationFlowState.Error;
        }
    }

}
