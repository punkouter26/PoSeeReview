@page "/leaderboard"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Client.Services
@inject ApiClient ApiClient
@inject ILogger<Leaderboard> Logger
@inject ShareService ShareService
@inject NavigationManager Navigation
@inject FxService Fx
@inject BoardMemoryService BoardMemory

<PageTitle>Hall of Fame - PoSeeReview</PageTitle>

@* Class keeps `.leaderboard-container` on the element so the E2E UI suite's selector, and the
   page's own scoped rules, both still resolve. *@
<PageShell Title="Hall of Fame"
           Subtitle="The strangest restaurant experiences from around the world"
           Hero="true"
           Width="PageShell.ShellWidth.Wide"
           Class="leaderboard-container">

    <Header>
        @* The API has supported ?region= and a US-WA-Seattle hierarchy from the start; the
           client hardcoded "US", so every non-US visitor was shown a board with nothing to do
           with them. These chips are the client half that was missing. *@
        <div class="board-controls">
            <div class="board-scope" role="group" aria-label="Leaderboard scope">
                <button type="button" class="chip-toggle @(_scope == BoardScope.Live ? "chip-toggle--active" : "")"
                        aria-pressed="@(_scope == BoardScope.Live)"
                        @onclick="() => SwitchScopeAsync(BoardScope.Live)">
                    Right now
                </button>
                <button type="button" class="chip-toggle @(_scope == BoardScope.Weekly ? "chip-toggle--active" : "")"
                        aria-pressed="@(_scope == BoardScope.Weekly)"
                        @onclick="() => SwitchScopeAsync(BoardScope.Weekly)">
                    By week
                </button>
            </div>

            <label class="region-picker">
                <span class="visually-hidden">Region</span>
                <select class="region-select" @onchange="OnRegionChangedAsync" aria-label="Region">
                    @foreach (var region in Regions)
                    {
                        <option value="@region.Code" selected="@(region.Code == _region)">@region.Label</option>
                    }
                </select>
            </label>
        </div>
    </Header>

    <ChildContent>

    <div id="@LeaderboardResultsId" aria-live="polite" aria-busy="@(isLoading ? "true" : "false")">

    @if (isLoading && ((_scope == BoardScope.Live && (leaderboardEntries == null || leaderboardEntries.Count == 0))
                       || (_scope == BoardScope.Weekly && _archive is null)))
    {
        @* One loading component for the whole app. It carries role="status" + aria-busy, which a
           bare Radzen spinner does not — those pages asked screen readers to sit through an
           unannounced indefinite wait. *@
        <LoadingIndicator Message="Tallying the strangest reviews..." />
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (_scope == BoardScope.Live && (leaderboardEntries == null || leaderboardEntries.Count == 0))
    {
        <div class="no-entries">
            <div class="empty-panels">
                <div class="empty-panel">&#128269;</div>
                <div class="empty-panel">&#127869;&#65039;</div>
                <div class="empty-panel">&#129300;</div>
                <div class="empty-panel">&#10067;</div>
            </div>
            <h2 class="empty-title">No Weird Stories Yet!</h2>
            <p class="empty-body">No strange restaurant tales on the board yet.<br />Go discover one — the weirder the better!</p>
            <a href="/" class="empty-home-btn">&#127968; Find Restaurants Near Me</a>
        </div>
    }
    else if (_scope == BoardScope.Weekly)
    {
        <h2 class="visually-hidden">Weekly hall of fame</h2>

        @if (_archive is null || _archive.Weeks.Count == 0)
        {
            <div class="state-card">
                <div class="state-card-icon" aria-hidden="true">📚</div>
                <h3 class="state-card-title">The archive is still filling up</h3>
                <p class="state-card-body">
                    Every comic that makes the board gets filed here by week, and stays after the
                    comic itself expires. Nothing recorded for @_region yet.
                </p>
            </div>
        }
        else
        {
            <div class="archive">
                @foreach (var week in _archive.Weeks)
                {
                    <section class="archive-week">
                        <h3 class="archive-week-title">
                            Week of @week.WeekStart.ToLocalTime().ToString("MMM d, yyyy")
                        </h3>

                        <ol class="archive-list">
                            @foreach (var entry in week.Entries)
                            {
                                <li class="archive-entry glass">
                                    <span class="archive-rank">@GetMedal(entry.Rank)</span>

                                    <div class="archive-thumb">
                                        @if (entry.ImageExpired)
                                        {
                                            @* The comic's blob is gone but the record is not, which
                                               is the entire point of an archive. A score card beats
                                               a broken image. *@
                                            <div class="archive-thumb-gone">
                                                <span class="archive-gone-score">@entry.StrangenessScore.ToString("F0")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId)" alt="@($"Comic for {entry.RestaurantName}")" loading="lazy" />
                                        }
                                    </div>

                                    <div class="archive-details">
                                        <span class="archive-name">@entry.RestaurantName</span>
                                        <span class="archive-score">@entry.StrangenessScore.ToString("F0") weird</span>
                                    </div>

                                    <a class="btn btn-secondary archive-open"
                                       href="/comic/@entry.PlaceId?from=leaderboard">
                                        @(entry.ImageExpired ? "Redraw" : "Open")
                                    </a>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>
        }
    }
    else
    {
        <h2 class="visually-hidden">Top 10 strangest restaurants</h2>

        @* The server stamps LastUpdated with the request time, so it only ever said "now".
           Report when THIS page last fetched, which is a fact we actually own. *@
        <div class="last-updated">
            <span>Loaded @lastLoadedLocal.ToString("t")</span>
            <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="btn btn-secondary" Click="@(_ => LoadLeaderboardAsync())" Disabled="@isLoading">
                &#8635; Refresh
            </RadzenButton>
        </div>

        @* Decoration BEHIND the list, never instead of it. The <canvas> is aria-hidden and
           pointer-events:none; every row below stays a real focusable, selectable, screen-reader
           legible element. A 3D scene that replaced this list would make the leaderboard
           unreachable by keyboard and invisible to assistive tech — see shelf.js. *@
        <div class="shelf-stage">
            <canvas @ref="_shelfCanvas" class="shelf-canvas" aria-hidden="true"></canvas>

        <div class="leaderboard-list cq-list">
            @foreach (var entry in leaderboardEntries ?? [])
            {
                @* data-move drives the row's arrival animation. An attribute rather than a class
                   because it carries three states and CSS wants to key different treatments off
                   each — see "BOARD MOVEMENT" in app.css. *@
                <div class="leaderboard-card glass scroll-enter @GetRankClass(entry.Rank)"
                     data-move="@MoveStateFor(entry.PlaceId)"
                     @onmouseenter="() => PreviewSignatureAsync(entry)"
                     @onfocusin="() => PreviewSignatureAsync(entry)">
                    <div class="rank-badge">
                        <div class="medal @GetMedalClass(entry.Rank)">@GetMedal(entry.Rank)</div>
                        @* Rendered only for rows that actually moved since this browser last
                           looked. A board that churns daily previously gave a returning visitor
                           no way to tell a complete reshuffle from no change at all. *@
                        @if (DeltaFor(entry.PlaceId) is { } delta && delta != 0)
                        {
                            <span class="rank-delta" data-direction="@(delta > 0 ? "up" : "down")"
                                  title="@(delta > 0 ? $"Up {delta} since your last visit" : $"Down {-delta} since your last visit")">
                                <span aria-hidden="true">@(delta > 0 ? "▲" : "▼")</span>
                                <span class="visually-hidden">@(delta > 0 ? $"Up {delta} places since your last visit" : $"Down {-delta} places since your last visit")</span>
                                @Math.Abs(delta)
                            </span>
                        }
                    </div>

                    <div class="comic-thumbnail">
                        <img src="@ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId)" alt="Comic for @entry.RestaurantName" loading="lazy" />
                    </div>

                    <div class="entry-details">
                        <h3 class="restaurant-name">@entry.RestaurantName</h3>
                        <p class="address">@entry.Address</p>
                        <div class="score-badge">
                            <span class="score-label">Weird score</span>
                            <span class="score-value">@entry.StrangenessScore.ToString("F0")</span>
                        </div>
                        <p class="entry-recorded">Recorded @entry.LastUpdated.ToLocalTime().ToString("MMM d, yyyy")</p>
                    </div>

                    <div class="entry-actions">
                        <a href="/comic/@entry.PlaceId?from=leaderboard" class="btn btn-primary">Open Comic</a>
                        <button class="btn btn-share-small" @onclick="() => ShareComicAsync(entry)" title="Share this comic">
                            &#128228;
                        </button>
                    </div>
                </div>
            }
        </div>
        </div>
    }

    </div>

    @* Outside the results live region on purpose: this is already role="status", and nesting
       two live regions makes a share confirmation announce twice. *@
    @if (shareToast != null)
    {
        <div class="toast" role="status">@shareToast</div>
    }

    </ChildContent>
</PageShell>

@code {
    /// <summary>DOM id the results live region uses.</summary>
    private const string LeaderboardResultsId = "leaderboard-results";
    private const int TopTen = 10;

    /// <summary>Which board is being shown — the churning live one, or the permanent archive.</summary>
    private enum BoardScope { Live, Weekly }

    /// <summary>
    /// Regions offered in the picker.
    /// <para>
    /// A short, curated list rather than every ISO code: the board is only interesting where
    /// comics actually exist, and a 200-entry select of mostly-empty countries is worse than no
    /// picker at all. The API accepts the full hierarchy, so narrower codes still work by URL.
    /// </para>
    /// </summary>
    private static readonly (string Code, string Label)[] Regions =
    [
        ("US", "🇺🇸 United States"),
        ("GB", "🇬🇧 United Kingdom"),
        ("CA", "🇨🇦 Canada"),
        ("AU", "🇦🇺 Australia"),
        ("IE", "🇮🇪 Ireland"),
        ("NZ", "🇳🇿 New Zealand")
    ];

    /// <summary>Weeks of archive requested at once.</summary>
    private const int ArchiveWeeks = 6;

    private BoardScope _scope = BoardScope.Live;
    private string _region = "US";
    private HallOfFameResponse? _archive;

    private List<LeaderboardEntryDto>? leaderboardEntries;
    private DateTimeOffset lastLoadedLocal = DateTimeOffset.Now;
    private string? errorMessage;
    private bool isLoading = false;
    private string? shareToast;
    private System.Threading.Timer? shareToastTimer;

    /// <summary>
    /// Rank change per place since this browser last saw this region's board. Empty on a first
    /// visit, which is deliberate: ten "new" badges at once would say nothing about change.
    /// </summary>
    private Dictionary<string, int> _deltas = [];

    /// <summary>Guards the arrival chord so a re-render cannot replay it.</summary>
    private bool _chordPlayed;

    /// <summary>Last place whose motif was previewed, so a jittery pointer does not retrigger.</summary>
    private string? _previewedPlaceId;

    private ElementReference _shelfCanvas;
    private int _shelfHandle;
    /// <summary>Entry count the shelf was last built for, so it only restarts when that changes.</summary>
    private int _shelfBuiltFor = -1;

    public async ValueTask DisposeAsync()
    {
        shareToastTimer?.Dispose();
        await StopShelfAsync();
    }

    /// <summary>
    /// Starts or restarts the 3D shelf once the list it sits behind has rendered.
    /// <para>
    /// Every failure path here ends with the plain list, which is the complete feature on its
    /// own — the shelf is decoration and is allowed to simply not happen. A zero handle means it
    /// did not start, which is also what a device below the 'full' tier gets.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the live board has a shelf. The archive is a scrolling list of weeks; a fixed
        // scene behind it would sit behind whichever week happened to be in view.
        if (_scope != BoardScope.Live || isLoading)
        {
            await StopShelfAsync();
            return;
        }

        var entries = leaderboardEntries;
        if (entries is null || entries.Count == 0)
        {
            await StopShelfAsync();
            return;
        }

        if (_shelfHandle != 0 && _shelfBuiltFor == entries.Count)
        {
            return;
        }

        await StopShelfAsync();

        _shelfHandle = await Fx.StartShelfAsync(
            _shelfCanvas,
            [.. entries.Select(e => new FxShelfEntry(e.Rank, e.StrangenessScore))]);
        _shelfBuiltFor = entries.Count;
    }

    private async Task StopShelfAsync()
    {
        if (_shelfHandle == 0)
        {
            return;
        }

        await Fx.StopShelfAsync(_shelfHandle);
        _shelfHandle = 0;
        _shelfBuiltFor = -1;
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboardAsync();
        
    }

    /// <summary>Switches between the live board and the archive, loading on first visit.</summary>
    private async Task SwitchScopeAsync(BoardScope scope)
    {
        if (_scope == scope)
        {
            return;
        }

        _scope = scope;
        await LoadCurrentScopeAsync();
    }

    private async Task OnRegionChangedAsync(ChangeEventArgs args)
    {
        var region = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(region) || region == _region)
        {
            return;
        }

        _region = region;

        // Both views are region-scoped, so a change invalidates whichever is cached. Clearing
        // the archive is what stops the previous country's weeks showing under the new flag.
        _archive = null;
        leaderboardEntries = null;

        await LoadCurrentScopeAsync();
    }

    private Task LoadCurrentScopeAsync() =>
        _scope == BoardScope.Weekly ? LoadArchiveAsync() : LoadLeaderboardAsync();

    private async Task LoadArchiveAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            _archive = await ApiClient.GetWeeklyHallOfFameAsync(_region, ArchiveWeeks, TopTen);

            if (_archive is null)
            {
                errorMessage = "Unable to load the weekly archive. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading the weekly archive for {Region}", _region);
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLeaderboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogInformation("Fetching Hall of Fame top {Limit} for {Region}", TopTen, _region);

            var response = await ApiClient.GetLeaderboardAsync(_region, TopTen);

            if (response != null)
            {
                leaderboardEntries = response.Entries
                    .Where(e => !string.IsNullOrWhiteSpace(e.ComicBlobUrl))
                    .ToList();
                lastLoadedLocal = DateTimeOffset.Now;
                Logger.LogInformation("Loaded {Count} leaderboard entries with comics", leaderboardEntries.Count);

                // Best-effort and never allowed to fail the page: the board is the thing the user
                // came for, and "what changed since last time" is a bonus on top of it.
                try
                {
                    await ReportBoardChangeAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not report board movement for {Region}", _region);
                }
            }
            else
            {
                errorMessage = "Unable to load leaderboard. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading leaderboard");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Rank change for a row, or null if it did not move / is new / first visit.</summary>
    private int? DeltaFor(string placeId) =>
        _deltas.TryGetValue(placeId, out var delta) ? delta : null;

    /// <summary>
    /// Which arrival treatment a row gets: climbed, fell, or neither. Rows that did not move are
    /// deliberately indistinguishable from rows on a first visit — "nothing happened" and "we
    /// don't know" should look the same, because in both cases there is nothing to point at.
    /// </summary>
    private string MoveStateFor(string placeId) => DeltaFor(placeId) switch
    {
        > 0 => "up",
        < 0 => "down",
        _ => "still"
    };

    /// <summary>
    /// Works out what moved, sounds the board, then records the current standings.
    /// <para>
    /// Order matters and is easy to get wrong: saving before comparing would compare the board
    /// against itself and report every row as unchanged, for ever.
    /// </para>
    /// </summary>
    private async Task ReportBoardChangeAsync()
    {
        var entries = leaderboardEntries;
        if (entries is null || entries.Count == 0)
        {
            return;
        }

        var previous = await BoardMemory.GetAsync(_region);

        _deltas = [];
        if (previous.Count > 0)
        {
            foreach (var entry in entries)
            {
                if (previous.TryGetValue(entry.PlaceId, out var was) && was != entry.Rank)
                {
                    // Positive is a CLIMB. Ranks count the other way (1 is best), so the
                    // subtraction is deliberately reversed — getting this backwards would show a
                    // green up-arrow on every row that fell.
                    _deltas[entry.PlaceId] = was - entry.Rank;
                }
            }
        }

        await BoardMemory.SaveAsync(_region, entries.Select(e => (e.PlaceId, e.Rank)));

        // The chord is the board heard at once — each voice one restaurant's own motif, seeded
        // from its place id. It plays only if audio is already unlocked, which on this route means
        // the visitor turned sound on earlier in the session; nothing here can unlock it, because
        // rendering a list is not a user gesture.
        if (!_chordPlayed)
        {
            _chordPlayed = true;
            await Fx.PlayBoardChordAsync(
                [.. entries.Take(3).Select(e => new FxMotif(e.PlaceId, e.StrangenessScore))]);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Plays a row's own motif on hover or keyboard focus.
    /// <para>
    /// This is what makes the board recognisable by ear rather than merely noisy: the figure is
    /// deterministic from the place id, so the same restaurant always sounds the same. Guarded
    /// against the same row retriggering, because a pointer crossing a card generates a stream of
    /// enter events and the motif is nearly a second long.
    /// </para>
    /// </summary>
    private async Task PreviewSignatureAsync(LeaderboardEntryDto entry)
    {
        if (_previewedPlaceId == entry.PlaceId)
        {
            return;
        }

        _previewedPlaceId = entry.PlaceId;
        await Fx.PlaySignatureAsync(entry.PlaceId, (int)Math.Round(entry.StrangenessScore));
    }

    // Rank 1 is gold — it carries .medal-gold styling, so a party popper read as a mismatch
    // next to the silver and bronze medals below it.
    private static string GetMedal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}" };
    private static string GetMedalClass(int rank) => rank switch { 1 => "medal-gold", 2 => "medal-silver", 3 => "medal-bronze", _ => "medal-default" };

    private static string GetRankClass(int rank) => rank switch { 1 => "rank-gold", 2 => "rank-silver", 3 => "rank-bronze", _ => "" };

    private async Task ShareComicAsync(LeaderboardEntryDto entry)
    {
        try
        {
            var comicUrl = $"{Navigation.BaseUri}comic/{entry.PlaceId}";
            var title = $"Strange Review Comic - {entry.RestaurantName}";
            var text = $"Check out this weird review comic! Strangeness: {entry.StrangenessScore:F0}/100 🎨 #PoSeeReview";

            var outcome = await ShareService.IsShareSupportedAsync()
                ? await ShareService.ShareComicAsync(title, text, comicUrl)
                : ShareOutcome.Unsupported;

            // Every branch now reports back. Copying to the clipboard with no confirmation —
            // what this did before — is indistinguishable from a dead button.
            switch (outcome)
            {
                case ShareOutcome.Shared:
                    ShowShareToast("Shared!");
                    break;
                case ShareOutcome.Cancelled:
                    break;
                default:
                    await ShareService.CopyToClipboardAsync(comicUrl);
                    ShowShareToast("✓ Link copied to clipboard");
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sharing comic for {PlaceId}", entry.PlaceId);
            ShowShareToast("Couldn't share that comic.");
        }
    }

    private void ShowShareToast(string message)
    {
        shareToast = message;
        StateHasChanged();

        shareToastTimer?.Dispose();
        shareToastTimer = new System.Threading.Timer(_ =>
        {
            shareToast = null;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }


}
