@page "/leaderboard"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Client.Services
@inject ApiClient ApiClient
@inject ILogger<Leaderboard> Logger
@inject ShareService ShareService
@inject NavigationManager Navigation
@inject FxService Fx

<PageTitle>Hall of Fame - PoSeeReview</PageTitle>

@* Class keeps `.leaderboard-container` on the element so the E2E UI suite's selector, and the
   page's own scoped rules, both still resolve. *@
<PageShell Title="Hall of Fame"
           Subtitle="The strangest restaurant experiences from around the world"
           Hero="true"
           Width="PageShell.ShellWidth.Wide"
           Class="leaderboard-container">

    @* Toggle buttons, NOT an ARIA tablist. These were role="tab" inside a role="tablist" with
       zero tabpanels, no aria-controls, tabindex=0 on all eight, and no arrow-key handling —
       so a screen reader announced "tab 1 of 8" and the arrow keys every tab user then pressed
       did nothing. They refilter the list below in place, which is what aria-pressed describes.
       aria-controls points at the results region so the relationship survives. *@
    <div class="region-selector">
        <div class="region-chips" role="group" aria-label="Filter leaderboard by region">
            @foreach (var (regionCode, flag, label) in _regions)
            {
                <button type="button"
                        class="region-chip @(selectedRegion == regionCode ? "active" : "")"
                        @onclick="() => SelectRegionAsync(regionCode)"
                        aria-pressed="@(selectedRegion == regionCode ? "true" : "false")"
                        aria-controls="@LeaderboardResultsId"
                        aria-label="@label"
                        title="@label">
                    <span class="region-flag" aria-hidden="true">@flag</span>
                    <span class="region-code" aria-hidden="true">@regionCode</span>
                </button>
            }
        </div>

        <div class="region-controls-row">
            <label for="limit" class="limit-label">Show:</label>
            <RadzenDropDown TValue="string" id="limit" @bind-Value="limitStr" Change="@(_ => OnLimitChangedAsync())"
                            Data="@_limitOptions" TextProperty="Text" ValueProperty="Value"
                            class="limit-select" aria-label="Number of entries to show" />

            @if (isLoading)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            }
        </div>
    </div>

    <div id="@LeaderboardResultsId" aria-live="polite" aria-busy="@(isLoading ? "true" : "false")">

    @if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (leaderboardEntries == null || leaderboardEntries.Count == 0)
    {
        <div class="no-entries">
            <div class="empty-panels">
                <div class="empty-panel">&#128269;</div>
                <div class="empty-panel">&#127869;&#65039;</div>
                <div class="empty-panel">&#129300;</div>
                <div class="empty-panel">&#10067;</div>
            </div>
            <h2 class="empty-title">No Weird Stories Yet!</h2>
            <p class="empty-body">No strange restaurant tales from <strong>@GetRegionName(selectedRegion)</strong> yet.<br />Go discover one — the weirder the better!</p>
            <a href="/" class="empty-home-btn">&#127968; Find Restaurants Near Me</a>
        </div>
    }
    else
    {
        @* PageShell renders the page's h1 and each card renders an h3, so the populated branch
           skipped a level. This heading closes it and gives the results list an accessible name;
           it is deliberately not painted, because the region chips above already say it. *@
        <h2 class="visually-hidden">Top @limit strangest restaurants in @GetRegionName(selectedRegion)</h2>

        @* The server stamps LastUpdated with the request time, so it only ever said "now".
           Report when THIS page last fetched, which is a fact we actually own. *@
        <div class="last-updated">
            <span>Loaded @lastLoadedLocal.ToString("t")</span>
            <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="btn btn-secondary" Click="@(_ => LoadLeaderboardAsync())" Disabled="@isLoading">
                &#8635; Refresh
            </RadzenButton>
        </div>

        @* Three.js shelf (FX #8) layered over the list, NOT replacing it. The DOM list below
           stays the real leaderboard: focusable, in reading order, and announced. A canvas-only
           3D list would be unreachable by keyboard and invisible to a screen reader, which is
           not a trade a leaderboard is worth. *@
        <div class="leaderboard-list shelf-host cq-list" @ref="_shelfHost">
            @foreach (var entry in leaderboardEntries)
            {
                <div class="leaderboard-card glass @GetRankClass(entry.Rank)">
                    <div class="rank-badge">
                        <div class="medal @GetMedalClass(entry.Rank)">@GetMedal(entry.Rank)</div>
                    </div>

                    <div class="comic-thumbnail">
                        @if (!string.IsNullOrWhiteSpace(entry.ComicBlobUrl))
                        {
                            <img src="@entry.ComicBlobUrl" alt="Comic for @entry.RestaurantName" loading="lazy" />
                        }
                        else
                        {
                            @* Was a plain <div> that said "Tap to redraw" and did nothing. *@
                            <a href="/comic/@entry.PlaceId?from=leaderboard" class="comic-thumbnail-placeholder"
                               aria-label="Comic image for @entry.RestaurantName expired — open to redraw it">
                                <span class="placeholder-icon">🎨</span>
                                <span class="placeholder-text">Tap to redraw</span>
                            </a>
                        }
                    </div>

                    <div class="entry-details">
                        <h3 class="restaurant-name">@entry.RestaurantName</h3>
                        <p class="address">@entry.Address</p>
                        <div class="score-badge">
                            <span class="score-label">Weird score</span>
                            <span class="score-value">@entry.StrangenessScore.ToString("F0")</span>
                        </div>
                        <p class="entry-recorded">Recorded @entry.LastUpdated.ToLocalTime().ToString("MMM d, yyyy")</p>
                    </div>

                    <div class="entry-actions">
                        <a href="/comic/@entry.PlaceId?from=leaderboard" class="btn btn-primary">Open Comic</a>
                        <button class="btn btn-share-small" @onclick="() => ShareComicAsync(entry)" title="Share this comic">
                            &#128228;
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    </div>

    @* Outside the results live region on purpose: this is already role="status", and nesting
       two live regions makes a share confirmation announce twice. *@
    @if (shareToast != null)
    {
        <div class="copy-toast" role="status">@shareToast</div>
    }
</PageShell>

@code {
    private static readonly (string Code, string Flag, string Label)[] _regions =
    [
        ("US", "🇺🇸", "United States"),
        ("CA", "🇨🇦", "Canada"),
        ("GB", "🇬🇧", "United Kingdom"),
        ("AU", "🇦🇺", "Australia"),
        ("NZ", "🇳🇿", "New Zealand"),
        ("IE", "🇮🇪", "Ireland"),
        ("IN", "🇮🇳", "India"),
        ("SG", "🇸🇬", "Singapore"),
    ];

    /// <summary>
    /// Options for the Radzen dropdown, which binds to a data source rather than to child option
    /// elements the way the previous Fluent select did.
    /// <para>
    /// A record CLASS, not a ValueTuple: Radzen resolves TextProperty/ValueProperty by
    /// reflection over public PROPERTIES, and a tuple exposes Item1/Item2 as fields. Binding a
    /// tuple threw at render time and surfaced as Blazor's "An unhandled error has occurred".
    /// </para>
    /// </summary>
    private sealed record LimitOption(string Value, string Text);

    private static readonly LimitOption[] _limitOptions =
    [
        new("10", "Top 10"),
        new("25", "Top 25"),
        new("50", "Top 50"),
    ];

    /// <summary>DOM id the region chips' <c>aria-controls</c> points at.</summary>
    private const string LeaderboardResultsId = "leaderboard-results";

    private List<LeaderboardEntryDto>? leaderboardEntries;
    private string selectedRegion = "US";
    private int limit = 10;
    private string limitStr = "10";
    private DateTimeOffset lastLoadedLocal = DateTimeOffset.Now;
    private string? errorMessage;
    private bool isLoading = false;
    private string? shareToast;
    private System.Threading.Timer? shareToastTimer;

    private ElementReference _shelfHost;
    private bool _shelfStarted;
    private string? _shelfBuiltForRegion;

    /// <summary>
    /// Starts the shelf once entries exist, and rebuilds it when the region changes. Three.js is
    /// ~171KB gzipped and is dynamically imported here — a visitor who never opens the Hall of
    /// Fame never downloads it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (leaderboardEntries is not { Count: > 0 })
        {
            return;
        }

        if (_shelfStarted && _shelfBuiltForRegion == selectedRegion)
        {
            return;
        }

        if (_shelfStarted)
        {
            await Fx.StopHallShelfAsync();
        }

        _shelfStarted = true;
        _shelfBuiltForRegion = selectedRegion;
        await Fx.StartHallShelfAsync(_shelfHost, leaderboardEntries);
    }

    public async ValueTask DisposeAsync()
    {
        shareToastTimer?.Dispose();
        if (_shelfStarted)
        {
            await Fx.StopHallShelfAsync();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboardAsync();
        
    }

    private async Task OnLimitChangedAsync()
    {
        if (int.TryParse(limitStr, out var parsed))
            limit = parsed;
        await LoadLeaderboardAsync();
    }

    private async Task SelectRegionAsync(string code)
    {
        if (selectedRegion == code) return;
        selectedRegion = code;
        await LoadLeaderboardAsync();
    }

    private async Task LoadLeaderboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogInformation("Fetching leaderboard for region {Region} with limit {Limit}", selectedRegion, limit);
            
            var response = await ApiClient.GetLeaderboardAsync(selectedRegion, limit);

            if (response != null)
            {
                leaderboardEntries = response.Entries;
                lastLoadedLocal = DateTimeOffset.Now;
                Logger.LogInformation("Loaded {Count} leaderboard entries", leaderboardEntries.Count);
            }
            else
            {
                errorMessage = "Unable to load leaderboard. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading leaderboard");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Rank 1 is gold — it carries .medal-gold styling, so a party popper read as a mismatch
    // next to the silver and bronze medals below it.
    private static string GetMedal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}" };
    private static string GetMedalClass(int rank) => rank switch { 1 => "medal-gold", 2 => "medal-silver", 3 => "medal-bronze", _ => "medal-default" };

    private static string GetRankClass(int rank) => rank switch { 1 => "rank-gold", 2 => "rank-silver", 3 => "rank-bronze", _ => "" };

    private string GetRegionName(string region) => region switch
    {
        "US" => "the United States",
        "CA" => "Canada",
        "GB" => "the United Kingdom",
        "AU" => "Australia",
        "NZ" => "New Zealand",
        "IE" => "Ireland",
        "IN" => "India",
        "SG" => "Singapore",
        _ => region
    };

    private async Task ShareComicAsync(LeaderboardEntryDto entry)
    {
        try
        {
            var comicUrl = $"{Navigation.BaseUri}comic/{entry.PlaceId}";
            var title = $"Strange Review Comic - {entry.RestaurantName}";
            var text = $"Check out this weird review comic! Strangeness: {entry.StrangenessScore:F0}/100 🎨 #PoSeeReview";

            var outcome = await ShareService.IsShareSupportedAsync()
                ? await ShareService.ShareComicAsync(title, text, comicUrl)
                : ShareOutcome.Unsupported;

            // Every branch now reports back. Copying to the clipboard with no confirmation —
            // what this did before — is indistinguishable from a dead button.
            switch (outcome)
            {
                case ShareOutcome.Shared:
                    ShowShareToast("Shared!");
                    break;
                case ShareOutcome.Cancelled:
                    break;
                default:
                    await ShareService.CopyToClipboardAsync(comicUrl);
                    ShowShareToast("✓ Link copied to clipboard");
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sharing comic for {PlaceId}", entry.PlaceId);
            ShowShareToast("Couldn't share that comic.");
        }
    }

    private void ShowShareToast(string message)
    {
        shareToast = message;
        StateHasChanged();

        shareToastTimer?.Dispose();
        shareToastTimer = new System.Threading.Timer(_ =>
        {
            shareToast = null;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }


}
