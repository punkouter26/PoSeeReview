@page "/leaderboard"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Client.Services
@inject ApiClient ApiClient
@inject ILogger<Leaderboard> Logger
@inject ShareService ShareService
@inject NavigationManager Navigation
@inject FxService Fx
@inject BoardMemoryService BoardMemory

<PageTitle>Hall of Fame - PoSeeReview</PageTitle>

@* Class keeps `.leaderboard-container` on the element so the E2E UI suite's selector still
   resolves. No region picker: both views are worldwide (a regional live board is still reachable
   by URL, ?region=US). The one control is WHEN — the live board churns with 24-hour comics, and
   the weekly archive is the record that outlives them. *@
<PageShell Title="Hall of Fame"
           Width="PageShell.ShellWidth.Wide"
           Class="leaderboard-container">

    <Header>
        <div class="board-scope" role="group" aria-label="Leaderboard scope">
            <button type="button" class="chip-toggle @(_scope == BoardScope.Live ? "chip-toggle--active" : "")"
                    aria-pressed="@(_scope == BoardScope.Live ? "true" : "false")"
                    @onclick="() => SwitchScopeAsync(BoardScope.Live)">
                Right now
            </button>
            <button type="button" class="chip-toggle @(_scope == BoardScope.Weekly ? "chip-toggle--active" : "")"
                    aria-pressed="@(_scope == BoardScope.Weekly ? "true" : "false")"
                    @onclick="() => SwitchScopeAsync(BoardScope.Weekly)">
                By week
            </button>
            @if (_scope == BoardScope.Live)
            {
                <button type="button" class="btn btn-icon" @onclick="LoadLeaderboardAsync" disabled="@isLoading"
                        title="Refresh" aria-label="Refresh the board">
                    <span aria-hidden="true">&#8635;</span>
                </button>
            }
        </div>
    </Header>

    <ChildContent>
    <div id="@LeaderboardResultsId" aria-live="polite" aria-busy="@(isLoading ? "true" : "false")">
    @if (isLoading && (_scope == BoardScope.Weekly
                       ? _archive is null
                       : leaderboardEntries == null || leaderboardEntries.Count == 0))
    {
        <LoadingIndicator Message="Tallying the strangest reviews..." />
    }
    else if (errorMessage != null)
    {
        <StateCard Icon="⚠️" Title="Couldn't load the board" Alert="true">
            <ChildContent>@errorMessage</ChildContent>
            <Actions><button type="button" class="btn btn-secondary" @onclick="RetryAsync">Try again</button></Actions>
        </StateCard>
    }
    else if (_scope == BoardScope.Weekly)
    {
        <h2 class="visually-hidden">Weekly hall of fame</h2>
        @if (_archive is null || _archive.Weeks.Count == 0)
        {
            <StateCard Icon="📚" Title="The archive is still filling up">
                Every comic that makes the board gets filed here by week, and stays after the
                comic itself expires.
            </StateCard>
        }
        else
        {
            @foreach (var week in _archive.Weeks)
            {
                <h3 class="comic-rows-heading">Week of @week.WeekStart.ToString("MMM d, yyyy")</h3>
                <ol class="comic-rows">
                    @foreach (var entry in week.Entries)
                    {
                        <ComicRow Href="@($"/comic/{entry.PlaceId}?from=leaderboard")"
                                  Name="@entry.RestaurantName"
                                  Score="@((int)Math.Round(entry.StrangenessScore))"
                                  ImageUrl="@(entry.ImageExpired ? null : ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId))"
                                  Meta="@entry.Region">
                            <Leading><span class="rank-badge medal @GetMedalClass(entry.Rank)">@GetMedal(entry.Rank)</span></Leading>
                        </ComicRow>
                    }
                </ol>
            }
        }
    }
    else if (leaderboardEntries == null || leaderboardEntries.Count == 0)
    {
        <StateCard Icon="🤔" Title="No weird stories yet">
            <ChildContent>Nothing strange on the board right now. Go find one — the weirder the better.</ChildContent>
            <Actions><a href="/" class="btn btn-primary">Find restaurants</a></Actions>
        </StateCard>
    }
    else
    {
        <h2 class="visually-hidden">Top 10 strangest restaurants</h2>
        <ol class="comic-rows" @ref="_stage">
            @foreach (var entry in leaderboardEntries)
            {
                var delta = DeltaFor(entry.PlaceId);
                <ComicRow Class="@($"leaderboard-card {GetRankClass(entry.Rank)}")"
                          Href="@($"/comic/{entry.PlaceId}?from=leaderboard")"
                          Name="@entry.RestaurantName"
                          Score="@((int)Math.Round(entry.StrangenessScore))"
                          ImageUrl="@ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId)"
                          Meta="@entry.Address"
                          data-move="@MoveStateFor(entry.PlaceId)"
                          data-delta="@delta">
                    <Leading>
                        <span class="rank-badge medal @GetMedalClass(entry.Rank)">
                            @GetMedal(entry.Rank)
                            @if (delta is { } d and not 0)
                            {
                                <span class="rank-delta" data-direction="@(d > 0 ? "up" : "down")"
                                      title="@(d > 0 ? $"Up {d} since your last visit" : $"Down {-d} since your last visit")">
                                    <span aria-hidden="true">@(d > 0 ? "▲" : "▼")</span>
                                    <span class="visually-hidden">@(d > 0 ? $"Up {d} places since your last visit" : $"Down {-d} places since your last visit")</span>
                                    @Math.Abs(d)
                                </span>
                            }
                        </span>
                    </Leading>
                    <Actions>
                        <button type="button" class="btn btn-icon comic-row-action" @onclick="() => ShareComicAsync(entry)"
                                title="Share this comic" aria-label="@($"Share the comic for {entry.RestaurantName}")">
                            <span aria-hidden="true">&#128228;</span>
                        </button>
                    </Actions>
                </ComicRow>
            }
        </ol>
    }
    </div>
    @* Outside the results live region on purpose: this is already role="status", and nesting
       two live regions makes a share confirmation announce twice. *@
    @if (shareToast != null)
    {
        <div class="toast" role="status">@shareToast</div>
    }
    </ChildContent>
</PageShell>

@code {
    /// <summary>DOM id the results live region uses.</summary>
    private const string LeaderboardResultsId = "leaderboard-results";
    private const int TopTen = 10;

    /// <summary>Which view is showing — the churning live board or the permanent archive.</summary>
    private enum BoardScope { Live, Weekly }

    /// <summary>`?view=week` opens the archive tab.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    /// <summary>Weeks of archive requested at once.</summary>
    private const int ArchiveWeeks = 6;

    private BoardScope _scope = BoardScope.Live;
    private HallOfFameResponse? _archive;

    private List<LeaderboardEntryDto>? leaderboardEntries;
    private string? errorMessage;
    private bool isLoading = false;
    private string? shareToast;
    private System.Threading.Timer? shareToastTimer;

    /// <summary>
    /// Rank change per place since this browser last saw this region's board. Empty on a first
    /// visit, which is deliberate: ten "new" badges at once would say nothing about change.
    /// </summary>
    private Dictionary<string, int> _deltas = [];

    private ElementReference _stage;

    /// <summary>
    /// Rows moved since last visit and have not been animated yet. Consumed after the render
    /// that puts them in the DOM — the slide needs real rows to measure.
    /// </summary>
    private bool _movesPending;

    public ValueTask DisposeAsync()
    {
        shareToastTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _scope = string.Equals(View, "week", StringComparison.OrdinalIgnoreCase) ? BoardScope.Weekly : BoardScope.Live;

        await (_scope == BoardScope.Weekly ? LoadArchiveAsync() : LoadLeaderboardAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_movesPending && _scope == BoardScope.Live && leaderboardEntries is { Count: > 0 })
        {
            _movesPending = false;
            await Fx.AnimateBoardMovesAsync(_stage);
        }
    }

    /// <summary>Switches between the live board and the archive, loading the archive once.</summary>
    private async Task SwitchScopeAsync(BoardScope scope)
    {
        if (_scope == scope)
        {
            return;
        }

        _scope = scope;
        errorMessage = null;

        // In the URL so refresh and Back keep the tab. replace: a tab is not a page visit.
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", scope == BoardScope.Weekly ? "week" : null), replace: true);

        if (scope == BoardScope.Weekly && _archive is null)
        {
            await LoadArchiveAsync();
        }
        else if (scope == BoardScope.Live && leaderboardEntries is null)
        {
            await LoadLeaderboardAsync();
        }
    }

    private async Task LoadArchiveAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            _archive = await ApiClient.GetWeeklyHallOfFameAsync(ArchiveWeeks, TopTen);
            if (_archive is null)
            {
                errorMessage = "Unable to load the weekly archive. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading the weekly archive");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLeaderboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Empty region means worldwide — the "around the world" the subtitle promises.
            // A scoped board is still available by URL (?region=US) for direct deep links.
            Logger.LogInformation("Fetching Hall of Fame top {Limit} (worldwide)", TopTen);

            var response = await ApiClient.GetLeaderboardAsync(string.Empty, TopTen);

            if (response != null)
            {
                leaderboardEntries = response.Entries
                    .Where(e => !string.IsNullOrWhiteSpace(e.ComicBlobUrl))
                    .ToList();
                Logger.LogInformation("Loaded {Count} leaderboard entries with comics", leaderboardEntries.Count);

                // Best-effort and never allowed to fail the page: the board is the thing the user
                // came for, and "what changed since last time" is a bonus on top of it.
                try
                {
                    await ReportBoardChangeAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not report board movement (worldwide)");
                }
            }
            else
            {
                errorMessage = "Unable to load leaderboard. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading leaderboard");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Rank change for a row, or null if it did not move / is new / first visit.</summary>
    private int? DeltaFor(string placeId) =>
        _deltas.TryGetValue(placeId, out var delta) ? delta : null;

    /// <summary>
    /// Which arrival treatment a row gets: climbed, fell, or neither. Rows that did not move are
    /// deliberately indistinguishable from rows on a first visit — "nothing happened" and "we
    /// don't know" should look the same, because in both cases there is nothing to point at.
    /// </summary>
    private string MoveStateFor(string placeId) => DeltaFor(placeId) switch
    {
        > 0 => "up",
        < 0 => "down",
        _ => "still"
    };

    /// <summary>
    /// Works out what moved, then records the current standings.
    /// <para>
    /// Order matters and is easy to get wrong: saving before comparing would compare the board
    /// against itself and report every row as unchanged, for ever.
    /// </para>
    /// </summary>
    private async Task ReportBoardChangeAsync()
    {
        var entries = leaderboardEntries;
        if (entries is null || entries.Count == 0)
        {
            return;
        }

        var previous = await BoardMemory.GetAsync("GLOBAL");

        _deltas = [];
        if (previous.Count > 0)
        {
            foreach (var entry in entries)
            {
                if (previous.TryGetValue(entry.PlaceId, out var was) && was != entry.Rank)
                {
                    // Positive is a CLIMB. Ranks count the other way (1 is best), so the
                    // subtraction is deliberately reversed — getting this backwards would show a
                    // green up-arrow on every row that fell.
                    _deltas[entry.PlaceId] = was - entry.Rank;
                }
            }
        }

        await BoardMemory.SaveAsync("GLOBAL", entries.Select(e => (e.PlaceId, e.Rank)));
        _movesPending = _deltas.Count > 0;

        StateHasChanged();
    }

    // Rank 1 is gold — it carries .medal-gold styling, so a party popper read as a mismatch
    // next to the silver and bronze medals below it.
    private static string GetMedal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}" };
    private static string GetMedalClass(int rank) => rank switch { 1 => "medal-gold", 2 => "medal-silver", 3 => "medal-bronze", _ => "medal-default" };

    private static string GetRankClass(int rank) => rank switch { 1 => "rank-gold", 2 => "rank-silver", 3 => "rank-bronze", _ => "" };

    private Task RetryAsync() =>
        _scope == BoardScope.Weekly ? LoadArchiveAsync() : LoadLeaderboardAsync();

    private async Task ShareComicAsync(LeaderboardEntryDto entry)
    {
        try
        {
            var comicUrl = $"{Navigation.BaseUri}comic/{entry.PlaceId}";
            var title = $"Strange Review Comic - {entry.RestaurantName}";
            var text = $"Check out this weird review comic! Strangeness: {entry.StrangenessScore:F0}/100 🎨 #PoSeeReview";

            var outcome = await ShareService.IsShareSupportedAsync()
                ? await ShareService.ShareComicAsync(title, text, comicUrl, entry.PlaceId)
                : ShareOutcome.Unsupported;

            // Every branch now reports back. Copying to the clipboard with no confirmation —
            // what this did before — is indistinguishable from a dead button.
            switch (outcome)
            {
                case ShareOutcome.Shared:
                    ShowShareToast("Shared!");
                    break;
                case ShareOutcome.Cancelled:
                    break;
                default:
                    await ShareService.CopyToClipboardAsync(comicUrl);
                    ShowShareToast("✓ Link copied to clipboard");
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sharing comic for {PlaceId}", entry.PlaceId);
            ShowShareToast("Couldn't share that comic.");
        }
    }

    private void ShowShareToast(string message)
    {
        shareToast = message;
        StateHasChanged();

        shareToastTimer?.Dispose();
        shareToastTimer = new System.Threading.Timer(_ =>
        {
            shareToast = null;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }
}
