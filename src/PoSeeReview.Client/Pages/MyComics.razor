@page "/my-comics"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ComicHistoryService History
@inject CollectionsClient Collections
@inject NavigationManager Navigation
@inject FxService Fx
@implements IAsyncDisposable

<PageTitle>My Comics - PoSeeReview</PageTitle>

<PageShell Title="My Comics"
           Subtitle="What you have kept, and what this browser remembers"
           Width="PageShell.ShellWidth.Wide"
           Class="my-comics-container">

    @* Where a forgotten card goes. One canvas for the whole page rather than one per card: the
       solver is a single world, and a pile that knows about every dismissal can stack them. *@
    <canvas @ref="_dustCanvas" class="fx-overlay fx-dust-canvas" aria-hidden="true"></canvas>

    @* Two lists, and the split is the point. Kept comics live on the server: they survive the
       24-hour expiry, follow the account to another device, and are capped. History is whatever
       this browser has seen and never leaves it. *@
    @if (_kept is { Count: > 0 })
    {
        <section class="kept-section">
            <header class="kept-head">
                <h2 class="kept-title">Kept</h2>
                <p class="kept-sub">
                    @_kept.Count of @_keptLimit · saved to your account, and they outlast the 24-hour expiry
                </p>
            </header>

            <div class="my-comics-grid cq-list">
                @foreach (var comic in _kept)
                {
                    <article class="history-card glass scroll-enter" data-freshness="fresh">
                        <a class="history-thumb" href="@($"/comic/{comic.PlaceId}")" aria-label="@($"Open the comic for {comic.RestaurantName}")">
                            @if (comic.HasImage)
                            {
                                <img src="@comic.ImageUrl" alt="@($"Comic for {comic.RestaurantName}")" loading="lazy" />
                            }
                            else
                            {
                                @* The row is a bookmark whose stored copy could not be written.
                                   Showing the score beats a broken image icon. *@
                                <div class="history-thumb-expired">
                                    <span class="history-expired-score">@comic.StrangenessScore</span>
                                    <span class="history-expired-label">no image</span>
                                </div>
                            }
                        </a>

                        <div class="history-details">
                            <h3 class="history-name">@comic.RestaurantName</h3>
                            <p class="history-meta">
                                <span class="history-score">@comic.StrangenessScore weird</span>
                                <span class="history-seen">· kept @FormatSeen(comic.KeptAt)</span>
                            </p>

                            <div class="history-actions">
                                <a href="@($"/comic/{comic.PlaceId}")" class="btn btn-primary history-open">Open</a>
                                <button type="button"
                                        class="btn btn-icon history-forget"
                                        @onclick="(e) => ForgetKeptAsync(comic.PlaceId, e)"
                                        title="@($"Stop keeping {comic.RestaurantName}")"
                                        aria-label="@($"Stop keeping {comic.RestaurantName}")">
                                    <span aria-hidden="true">×</span>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (_entries is null)
    {
        <LoadingIndicator Message="Loading your comics..." />
    }
    else if (_entries.Count == 0)
    {
        <div class="state-card">
            <div class="state-card-icon" aria-hidden="true">📭</div>
            <h2 class="state-card-title">Nothing here yet</h2>
            <p class="state-card-body">
                Comics you open show up here automatically. Go find a restaurant with
                questionable reviews.
            </p>
            <div class="state-card-actions">
                <a href="/" class="btn btn-primary">Find Restaurants</a>
            </div>
        </div>
    }
    else
    {
        <div class="my-comics-toolbar">
            <p class="my-comics-count">
                @_entries.Count comic@(_entries.Count == 1 ? "" : "s") remembered
                @if (_expiredCount > 0)
                {
                    <span class="my-comics-expired-note">· @_expiredCount expired</span>
                }
            </p>

            @if (_confirmingClear)
            {
                <div class="clear-confirm" role="alert">
                    <span>Forget all of them?</span>
                    <button type="button" class="btn btn-secondary" @onclick="ClearAsync">Yes, clear</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => _confirmingClear = false">Cancel</button>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-secondary" @onclick="() => _confirmingClear = true">Clear history</button>
            }
        </div>

        @* This list never leaves the browser. Saying so plainly is the honest counterpart to
           storing it without asking, and it explains why it is empty on the user's other phone. *@
        <p class="my-comics-privacy">
            This history is stored only in this browser — never uploaded, and not shared between
            your devices. Keep a comic to save it to your account instead.
        </p>

        <div class="my-comics-grid cq-list">
            @foreach (var entry in _entries)
            {
                <article class="history-card glass scroll-enter @(entry.IsExpired ? "history-card--expired" : "")" data-freshness="@entry.Freshness">
                    <a class="history-thumb" href="@LinkFor(entry)" aria-label="@($"Open the comic for {entry.RestaurantName}")">
                        @if (entry.IsExpired)
                        {
                            @* The blob is gone after cleanup, so rendering the <img> would show a
                               broken image on every aged card. The score is what survives, and
                               it is the part worth showing. *@
                            <div class="history-thumb-expired">
                                <span class="history-expired-score">@entry.StrangenessScore</span>
                                <span class="history-expired-label">expired</span>
                            </div>
                        }
                        else
                        {
                            <img src="@ComicImageUrl.For(entry.BlobUrl, entry.PlaceId)" alt="@($"Comic for {entry.RestaurantName}")" loading="lazy" />
                        }
                    </a>

                    <div class="history-details">
                        <h3 class="history-name">@entry.RestaurantName</h3>
                        <p class="history-meta">
                            <span class="history-score">@entry.StrangenessScore weird</span>
                            <span class="history-seen">· @FormatSeen(entry.ViewedAt)</span>
                        </p>

                        <div class="history-actions">
                            <a href="@LinkFor(entry)" class="btn btn-primary history-open">
                                @(entry.IsExpired ? "Redraw" : "Open")
                            </a>
                            <button type="button"
                                    class="btn btn-icon history-forget"
                                    @onclick="(e) => ForgetAsync(entry.PlaceId, e)"
                                    title="@($"Forget {entry.RestaurantName}")"
                                    aria-label="@($"Forget {entry.RestaurantName}")">
                                <span aria-hidden="true">×</span>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</PageShell>

@code {
    private List<ComicHistoryEntry>? _entries;
    private List<KeptComicDto>? _kept;
    private int _keptLimit;
    private bool _confirmingClear;

    private int _expiredCount;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _entries = await History.GetAllAsync();
        _expiredCount = _entries.Count(e => e.IsExpired);

        // A failed read renders as "nothing kept" rather than an error banner. The local history
        // below is the part of this page that always works, and it should not be taken down by a
        // server call.
        var collection = await Collections.GetAsync();
        _kept = collection?.Comics ?? [];
        _keptLimit = collection?.Limit ?? 0;
    }

    private async Task ForgetKeptAsync(string placeId, MouseEventArgs args)
    {
        await ScatterAsync(args);
        await Collections.ForgetAsync(placeId);
        await ReloadAsync();
    }

    /// <summary>
    /// An expired entry links straight into generation; a live one does not.
    /// <para>
    /// This is the whole reason expiry is worth surfacing rather than hiding. An aged card is
    /// not dead weight — it is a one-tap prompt to spend a generation on a place the user has
    /// already shown interest in.
    /// </para>
    /// </summary>
    private static string LinkFor(ComicHistoryEntry entry) =>
        entry.IsExpired
            ? $"/comic/{entry.PlaceId}?generate=true"
            : $"/comic/{entry.PlaceId}";

    private async Task ForgetAsync(string placeId, MouseEventArgs args)
    {
        await ScatterAsync(args);
        await History.RemoveAsync(placeId);
        await ReloadAsync();
    }

    /// <summary>
    /// The card coming apart where it was dismissed.
    /// <para>
    /// A row that simply vanishes from a grid is indistinguishable from a render glitch, and this
    /// page is entirely about things going away — half of it is a countdown to expiry. Giving the
    /// removal a body makes it read as the user having done something rather than as the list
    /// having lost track.
    /// </para>
    /// <para>
    /// Fired BEFORE the removal, on purpose: the burst is anchored to where the card is, and after
    /// the reload the grid has already reflowed and that position belongs to a different card.
    /// </para>
    /// </summary>
    private async Task ScatterAsync(MouseEventArgs args)
    {
        await Fx.UnlockAudioAsync();
        await Fx.PlayTapAtAsync(args.ClientX);

        if (_dustHandle == 0)
        {
            return;
        }

        // Coordinates are 0..1 over the canvas, which spans the page; the page is scrolled, so the
        // viewport coordinate has to be shifted by the scroll offset the canvas does not share.
        var originX = _viewportWidth > 0 ? Math.Clamp(args.ClientX / _viewportWidth, 0, 1) : 0.5;
        await Fx.ThrowReactionAsync(_dustHandle, "📄", originX, 0.35, args.ClientX);
    }

    private ElementReference _dustCanvas;
    private int _dustHandle;
    private double _viewportWidth = 1;

    /// <summary>
    /// Opens the dismissal pile once the grid has rendered. A zero handle is the ordinary case
    /// below the Full tier and every call site treats it as "no effect".
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dustHandle = await Fx.StartReactionPileAsync(_dustCanvas);
        _viewportWidth = await Fx.GetViewportWidthAsync();
    }

    public async ValueTask DisposeAsync()
    {
        // The solver holds a frame task until it is told to stop, and a pile never ages out on
        // its own — that is the property that makes it right for reactions and makes forgetting
        // it here a leak that survives the route.
        if (_dustHandle != 0)
        {
            await Fx.StopInkAsync(_dustHandle);
            _dustHandle = 0;
        }
    }

    private async Task ClearAsync()
    {
        _confirmingClear = false;
        await History.ClearAsync();
        await ReloadAsync();
    }

    /// <summary>Relative time, because "yesterday" is more useful here than a timestamp.</summary>
    private static string FormatSeen(DateTimeOffset viewedAt)
    {
        var elapsed = DateTimeOffset.UtcNow - viewedAt;

        return elapsed switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)elapsed.TotalMinutes}m ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours}h ago",
            { TotalDays: < 7 } => $"{(int)elapsed.TotalDays}d ago",
            _ => viewedAt.ToLocalTime().ToString("MMM d")
        };
    }
}
