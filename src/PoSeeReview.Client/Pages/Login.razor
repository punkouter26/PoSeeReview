@page "/login"
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Login - PoSeeReview</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-logo">
            <svg class="login-brand-icon" width="48" height="48" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="11" height="11" rx="2" fill="white" fill-opacity="0.95"/>
                <rect x="15" y="1" width="11" height="11" rx="2" fill="white" fill-opacity="0.75"/>
                <rect x="1" y="15" width="11" height="11" rx="2" fill="white" fill-opacity="0.75"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="white" fill-opacity="0.5"/>
            </svg>
            <span class="login-brand-name">PoSeeReview</span>
        </div>
        <h1>Welcome Back</h1>
        <p>Sign in to discover strange restaurant stories nearby and turn them into shareable comics.</p>

        <div class="login-actions">
            @if (IsTest)
            {
                @* Test env enforces the guest bypass so automated suites skip interactive auth (NET_RULES 4.4). *@
                <p>Signing in as guest&hellip;</p>
            }
            else
            {
                <button class="login-btn login-btn-microsoft" @onclick="LoginWithMicrosoft">
                    <svg class="login-btn-icon" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                        <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                        <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    Sign in with Microsoft
                </button>
                @if (IsDevelopment)
                {
                    <button class="login-btn login-btn-secondary" @onclick="LoginAsGuest">Continue As Guest</button>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool IsDevelopment => HostEnvironment.Environment == "Development";
    private bool IsTest => HostEnvironment.Environment == "Test";

    private string EscapedReturnUrl => Uri.EscapeDataString(
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/");

    protected override void OnInitialized()
    {
        if (IsTest)
        {
            LoginAsGuest();
        }
    }

    private void LoginWithMicrosoft() =>
        Navigation.NavigateTo($"auth/login/microsoft?returnUrl={EscapedReturnUrl}", forceLoad: true);

    private void LoginAsGuest() =>
        Navigation.NavigateTo($"auth/login/fake?returnUrl={EscapedReturnUrl}", forceLoad: true);
}
