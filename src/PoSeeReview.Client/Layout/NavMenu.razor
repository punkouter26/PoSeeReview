@using System.Net.Http.Json
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@inject FxService Fx
@implements IDisposable

<div class="top-row">
    <div class="nav-shell">
        <a class="navbar-brand" href="">
            <svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.9" stroke="currentColor" stroke-width="0.5"/>
                <rect x="15" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
                <rect x="1" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
            <span>
                <span class="brand-name">PoSeeReview</span>
                @if (_isMockData)
                {
                    <span class="nav-mock-badge" title="Running with mock data — no real AI or storage connections">USING MOCK DATA</span>
                }
            </span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5Z"/></svg>
                    <span class="nav-label">Home</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="leaderboard">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 2a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v1a3.5 3.5 0 0 1-3.362 3.496A5.002 5.002 0 0 1 8.5 10.9V12h2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1h2v-1.1a5.002 5.002 0 0 1-2.138-4.404A3.5 3.5 0 0 1 2 3V2Zm1 1a2.5 2.5 0 0 0 2.45 2.5A5.03 5.03 0 0 1 5 3H3Zm8 0a5.03 5.03 0 0 1-.45 2.5A2.5 2.5 0 0 0 13 3h-2Z"/></svg>
                    <span class="nav-label">Hall of Fame</span>
                </NavLink>
            </div>
        </nav>

        @* One account control. A native popover: light-dismiss, Esc and the top layer come free,
           with no JS. Keyed on the route so navigating from inside it (My comics) closes it — a
           new element is not in the top layer. *@
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-user-zone">
                    <button type="button" class="nav-user-badge nav-user-badge--user" popovertarget="account-menu"
                            title="@(auth.User.Identity?.Name ?? "Account")"
                            aria-label="@($"{auth.User.Identity?.Name ?? "User"}, account menu")">
                        <span class="nav-user-dot" aria-hidden="true"></span>
                        <span class="nav-user-email nav-user-label">@(auth.User.Identity?.Name ?? "User")</span>
                    </button>
                    <div id="account-menu" class="popover-menu nav-account-menu" popover @key="Navigation.Uri">
                        <p class="popover-menu-title">@(auth.User.Identity?.Name ?? "User")</p>
                        <NavLink class="popover-menu-item" href="my-comics">
                            <span aria-hidden="true">🗂️</span> My comics
                        </NavLink>

                        @* Audio defaults on, so the switch has to be somewhere a user can find it. Sound and
                           its volume share one row; what only matters while sound is on sits under it. *@
                        <div class="nav-sound" role="group" aria-label="Sound and haptics">
                            <div class="nav-sound-row">
                                <button type="button" class="chip-toggle @(_sound ? "chip-toggle--active" : "")"
                                        aria-pressed="@(_sound ? "true" : "false")" @onclick="ToggleSoundAsync">
                                    Sound
                                </button>
                                <input class="nav-volume" type="range" min="0" max="100" aria-label="Volume" disabled="@(!_sound)"
                                       @bind="_volume" @bind:event="oninput" @bind:after="ApplyVolumeAsync" />
                            </div>
                            <div class="nav-sound-row">
                                @if (_haptics.Supported)
                                {
                                    <button type="button" class="chip-toggle @(_haptics.Enabled ? "chip-toggle--active" : "")"
                                            aria-pressed="@(_haptics.Enabled ? "true" : "false")" @onclick="ToggleHapticsAsync">
                                        Haptics
                                    </button>
                                }
                                @* Opt-in, unlike the cues: a loop nobody asked for gets the whole app muted. *@
                                <button type="button" class="chip-toggle @(_music ? "chip-toggle--active" : "")"
                                        aria-pressed="@(_music ? "true" : "false")" disabled="@(!_sound)" @onclick="ToggleMusicAsync">
                                    Music
                                </button>
                            </div>
                        </div>
                        <hr class="popover-menu-divider" />
                        <button type="button" class="popover-menu-item" @onclick="Logout">Sign out</button>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool _isMockData;
    private bool _sound;
    private FxToggleState _haptics;
    private bool _music;
    private int _volume = 100;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            var mockStatus = await Http.GetFromJsonAsync("diag/mock-status", AppJsonContext.Default.MockStatusDto);
            _isMockData = mockStatus?.IsMockActive ?? false;
        }
        catch (HttpRequestException)
        {
            _isMockData = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _sound = await Fx.IsAudioEnabledAsync();
            _haptics = await Fx.GetHapticsAsync();
            _music = await Fx.IsSoundtrackEnabledAsync();
            _volume = (int)Math.Round(await Fx.GetVolumeAsync() * 100);
            StateHasChanged();
        }
    }

    /// <summary>The interop call is the first thing the click does: audio only starts on a gesture.</summary>
    private async Task ToggleSoundAsync()
    {
        _sound = await Fx.SetAudioEnabledAsync(!_sound);
        _haptics = await Fx.GetHapticsAsync();   // Haptics follow sound unless switched off.
    }

    private async Task ToggleHapticsAsync()
    {
        await Fx.SetHapticsEnabledAsync(!_haptics.Enabled);
        _haptics = await Fx.GetHapticsAsync();
    }

    private async Task ToggleMusicAsync() => _music = await Fx.SetSoundtrackEnabledAsync(!_music);

    private Task ApplyVolumeAsync() => Fx.SetVolumeAsync(_volume / 100.0);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        StateHasChanged();

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void Logout()
    {
        // Full-page navigation so the server clears the BFF auth cookie.
        Navigation.NavigateTo("auth/logout?returnUrl=%2Flogin", forceLoad: true);
    }
}
