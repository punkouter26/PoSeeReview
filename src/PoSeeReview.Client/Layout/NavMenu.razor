@using System.Net.Http.Json
@using PoSeeReview.Client.Services
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using PoSeeReview.Shared
@using PoSeeReview.Shared.Dtos
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row">
    <div class="nav-shell">
        <a class="navbar-brand" href="">
            <svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.9" stroke="currentColor" stroke-width="0.5"/>
                <rect x="15" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
                <rect x="1" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
            <span>
                <span class="brand-name">PoSeeReview</span>
                @if (_isMockData)
                {
                    <span class="nav-mock-badge" title="Running with mock data — no real AI or storage connections">USING MOCK DATA</span>
                }
            </span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span><span class="nav-label"> Home</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="leaderboard">
                    <span class="bi bi-trophy-fill" aria-hidden="true"></span><span class="nav-label"> Hall of Fame</span>
                </NavLink>
            </div>
        </nav>

        @* One account control instead of four. My comics, the signed-in identity and Sign out
           used to sit side by side in this zone, and
           because `.nav-links` is `flex: 1; min-width: 0` against a zone that cannot shrink,
           every one of them came straight out of the primary nav's width on a phone.

           A native popover: light-dismiss, Esc and the top layer come free, with no JS. It is
           keyed on the route so navigating from inside it (My comics) closes it — a new element
           is not in the top layer. *@
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-user-zone">
                    <button type="button" class="nav-user-badge nav-user-badge--user" popovertarget="account-menu"
                            title="@(auth.User.Identity?.Name ?? "Account")"
                            aria-label="@($"{auth.User.Identity?.Name ?? "User"}, account menu")">
                        <span class="nav-user-dot" aria-hidden="true"></span>
                        <span class="nav-user-email nav-user-label">@(auth.User.Identity?.Name ?? "User")</span>
                    </button>
                    <div id="account-menu" class="nav-account-menu" popover @key="Navigation.Uri">
                        <p class="nav-account-name">@(auth.User.Identity?.Name ?? "User")</p>
                        <NavLink class="nav-my-comics" href="my-comics">
                            <span aria-hidden="true">🗂️</span> My comics
                        </NavLink>
                        <button type="button" class="nav-logout-btn" @onclick="Logout">Sign out</button>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool _isMockData;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            var mockStatus = await Http.GetFromJsonAsync("diag/mock-status", AppJsonContext.Default.MockStatusDto);
            _isMockData = mockStatus?.IsMockActive ?? false;
        }
        catch (HttpRequestException)
        {
            _isMockData = false;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        StateHasChanged();

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void Logout()
    {
        // Full-page navigation so the server clears the BFF auth cookie.
        Navigation.NavigateTo("auth/logout?returnUrl=%2Flogin", forceLoad: true);
    }
}
