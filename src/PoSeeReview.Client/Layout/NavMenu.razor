@using System.Net.Http.Json
@using PoSeeReview.Client.Services
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using PoSeeReview.Shared
@using PoSeeReview.Shared.Dtos
@implements IDisposable
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject HttpClient Http
@inject DevSessionClient DevSessionClient
@inject DevSessionStateService SessionState
@inject NavigationManager Navigation
@inject FxService Fx

<div class="top-row">
    <div class="nav-shell">
        <a class="navbar-brand" href="">
            <svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="11" height="11" rx="2" fill="white" fill-opacity="0.9" stroke="white" stroke-width="0.5"/>
                <rect x="15" y="1" width="11" height="11" rx="2" fill="white" fill-opacity="0.7" stroke="white" stroke-width="0.5"/>
                <rect x="1" y="15" width="11" height="11" rx="2" fill="white" fill-opacity="0.7" stroke="white" stroke-width="0.5"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="white" fill-opacity="0.5" stroke="white" stroke-width="0.5"/>
            </svg>
            <span>
                <span class="brand-name">PoSeeReview</span>
                <span class="brand-tagline">Strange stories, illustrated</span>
                @if (_isMockData)
                {
                    <span class="nav-mock-badge" title="Running with mock data — no real AI or storage connections">USING MOCK DATA</span>
                }
            </span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span><span class="nav-label"> Home</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="leaderboard">
                    <span class="bi bi-trophy-fill" aria-hidden="true"></span><span class="nav-label"> Hall of Fame</span>
                </NavLink>
            </div>
        </nav>

        @* Right zone of the header contract (NET_RULES 4.1): Left branding | Center actions |
           Right session. This renders in EVERY environment — it was previously Development-only,
           which left Production with no identity and no way to sign out. The dev-session badge
           inside it stays Dev/Test-only; Production falls back to the authenticated principal. *@
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-user-zone">
                    @* Deliberately in the right-hand session zone, NOT in nav.nav-links. My
                       Comics is per-user state, and the primary nav is contractually two items
                       (HeaderContractUiTests asserts exactly that) — a third would both break
                       the test and dilute a two-destination app. *@
                    <NavLink class="nav-mycomics" href="my-comics" title="My Comics">
                        <span aria-hidden="true">🗂️</span>
                        <span class="nav-mycomics-label">My Comics</span>
                    </NavLink>
                    <NavLink class="nav-insights" href="insights" title="Insights">
                        <span aria-hidden="true">📊</span>
                        <span class="nav-insights-label">Insights</span>
                    </NavLink>

                    @* The sound switch, and it belongs here rather than on /diagnostics.
                       Audio defaults to off and needs a real user gesture to unlock, so until
                       now the ONLY control for it lived on a page with no nav entry that is
                       reached by typing a URL — which meant the entire audio layer was, in
                       practice, unreachable. This is a button, not a NavLink, and it is in the
                       right-hand session zone: the primary nav stays contractually two items. *@
                    <button type="button"
                            class="nav-sound-btn @(_audioEnabled ? "nav-sound-btn--on" : "")"
                            @onclick="ToggleAudioAsync"
                            title="@(_audioEnabled ? "Turn sound off" : "Turn sound on")"
                            aria-pressed="@_audioEnabled"
                            aria-label="@(_audioEnabled ? "Turn sound off" : "Turn sound on")">
                        <span aria-hidden="true">@(_audioEnabled ? "🔊" : "🔇")</span>
                    </button>
                    @if (_devSession != null)
                    {
                        <div class="nav-user-badge @(_devSession.IsAnonymous ? "nav-user-badge--anon" : "nav-user-badge--user")">
                            <span class="nav-user-dot" aria-hidden="true"></span>
                            @if (_devSession.IsAnonymous)
                            {
                                <span class="nav-user-label">Anon</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_devSession.Email))
                            {
                                <span class="nav-user-email nav-user-label" title="@_devSession.Email">@_devSession.Email</span>
                            }
                            else
                            {
                                <span class="nav-user-label">@_devSession.UserId</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="nav-user-badge nav-user-badge--user">
                            <span class="nav-user-dot" aria-hidden="true"></span>
                            <span class="nav-user-email nav-user-label" title="@auth.User.Identity?.Name">
                                @auth.User.Identity?.Name
                            </span>
                        </div>
                    }
                    <button class="nav-logout-btn" @onclick="LogoutAsync" title="Sign out">Sign out</button>
                </div>
            </Authorized>
            @* No unauthenticated session zone. An anonymous visitor is always on /login, which
               already presents the sign-in choice front and centre — a second "Not signed in /
               Sign in" pair in the header restated it and competed with the real CTA. *@
        </AuthorizeView>
    </div>
</div>

@code {
    private DevSessionDto? _devSession;
    private bool _isMockData;
    private bool _audioEnabled;

    protected override async Task OnInitializedAsync()
    {
        // Banner is driven by the server's IMockable registrations (NET_RULES 6.5).
        try
        {
            var mockStatus = await Http.GetFromJsonAsync("diag/mock-status", AppJsonContext.Default.MockStatusDto);
            _isMockData = mockStatus?.IsMockActive ?? false;
        }
        catch (HttpRequestException)
        {
            _isMockData = false;
        }

        _audioEnabled = await Fx.IsAudioEnabledAsync();

        if (IsDevOrTest)
        {
            _devSession = await DevSessionClient.GetCurrentSessionAsync();
            SessionState.Set(_devSession);
            SessionState.OnChanged += OnSessionChanged;
        }
    }

    // The dev-session badge is a local-tooling affordance; Production shows the real principal.
    private bool IsDevOrTest =>
        HostEnvironment.IsDevelopment() || HostEnvironment.IsEnvironment(HostEnvironments.Test);

    private void OnSessionChanged()
    {
        _devSession = SessionState.Current;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionState.OnChanged -= OnSessionChanged;
    }

    /// <summary>
    /// Turning sound on from a click handler is the only way it can work: a browser only lets an
    /// AudioContext leave 'suspended' from a trusted event, so a toggle wired to anything else —
    /// a timer, an await continuation, a stored preference applied at startup — leaves the app
    /// permanently silent while reporting that sound is on.
    /// <para>
    /// The confirmation is audible on purpose. A speaker icon changing state is not evidence
    /// that anything reached the speakers.
    /// </para>
    /// </summary>
    private async Task ToggleAudioAsync()
    {
        _audioEnabled = await Fx.SetAudioEnabledAsync(!_audioEnabled);

        if (_audioEnabled)
        {
            await Fx.PlayConfirmAsync();
        }
    }

    private async Task LogoutAsync()
    {
        if (IsDevOrTest)
        {
            await DevSessionClient.LogoutAsync();
        }

        // Full-page navigation so the server clears the BFF auth cookie (NET_RULES 4.4).
        Navigation.NavigateTo("auth/logout?returnUrl=%2Flogin", forceLoad: true);
    }
}
