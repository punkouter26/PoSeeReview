<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <StateCard Icon="🔒" Title="Not allowed" Heading1="true">
                            <ChildContent>Your account can't open this page.</ChildContent>
                            <Actions><a href="" class="btn btn-secondary">Back to home</a></Actions>
                        </StateCard>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found - PoSeeReview</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <StateCard Icon="🗺️" Title="This page got a 1-star review" Heading1="true">
                    <ChildContent>It doesn't exist — or maybe it closed down.</ChildContent>
                    <Actions>
                        <a href="" class="btn btn-primary">Back to home</a>
                        <a href="leaderboard" class="btn btn-secondary">Hall of Fame</a>
                    </Actions>
                </StateCard>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
