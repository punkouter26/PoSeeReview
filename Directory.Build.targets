<Project>
  <!-- The YYMMDD build stamp, on every assembly: the HEAD commit's UTC date, so a deploy is named
       by the code it shipped rather than the day CI happened to run. The client shows it in the
       corner (BuildStamp.razor); the API reports it on /diag (DiagnosticsSnapshotQueryHandler).
       rev-list rather than a log format string: its % is eaten by the cmd shell Exec uses on
       Windows. No git (a source zip, a container without .git) falls back to today's UTC date. -->
  <Target Name="StampBuildDate" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-list -1 --timestamp HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HeadCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_HeadCommitExit" />
    </Exec>
    <PropertyGroup>
      <BuildStamp Condition="'$(_HeadCommitExit)' == '0' and '$(_HeadCommit)' != ''">$([System.DateTime]::new(1970, 1, 1, 0, 0, 0, System.DateTimeKind.Utc).AddSeconds($(_HeadCommit.Split(' ')[0])).ToString('yyMMdd'))</BuildStamp>
      <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyMMdd'))</BuildStamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildStamp</_Parameter1>
        <_Parameter2>$(BuildStamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
